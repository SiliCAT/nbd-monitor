[Unit]
Description=NBD session timeout scan
After=network.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077

ExecStart=/usr/local/libexec/nbd-server scan

StandardInput=null
StandardOutput=journal
StandardError=journal
# Suppress routine PID 1 lifecycle chatter, preserve script evidence.
LogLevelMax=notice
SyslogLevel=notice

TimeoutStartSec=10min
TimeoutStopSec=10s
KillMode=control-group

RuntimeDirectory=nbd-server
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
