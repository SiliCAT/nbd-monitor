#!/bin/bash
# nbd-server v0.0.1 — development skeleton; no runtime business implemented.
set -euo pipefail

case "${1:-}" in
    --version)
        printf '%s\n' 'nbd-server 0.0.1 (development skeleton)'
        ;;
    --help|-h)
        printf '%s\n' 'nbd-server --version | --help' \
            'Reserved entry points (not implemented): request | export PORT | finish PORT | scan' \
            'Development skeleton. Do not deploy.'
        ;;
    *)
        printf '%s\n' 'nbd-server: v0.0.1 development skeleton; operation not implemented. Do not deploy.' >&2
        exit 1
        ;;
esac
