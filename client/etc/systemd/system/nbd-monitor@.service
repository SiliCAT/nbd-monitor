# v0.0.2 — runtime heartbeat only; native nbd@ owns finalization.
[Unit]
Description=Client-side NBD session monitor for %i (experimental)
Wants=network-online.target
After=network.target network-online.target
Before=nbd@%i.service
PartOf=nbd@%i.service
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/libexec/nbd-monitor run %i
TimeoutStartSec=15s
TimeoutStopSec=10s
KillMode=control-group
Restart=no
User=root
Group=root
UMask=0077
StandardOutput=journal
StandardError=journal
