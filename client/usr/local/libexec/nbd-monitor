#!/bin/bash
set -euo pipefail
export LC_ALL=C
umask 077

config=${NBD_MONITOR_CONFIG:-/etc/nbd-monitor.conf}
nbdtab=${NBD_MONITOR_NBDTAB:-/etc/nbdtab}
runtime=${NBD_MONITOR_RUNTIME:-/run/nbd-monitor}
sysfs=${NBD_MONITOR_SYS_CLASS_BLOCK:-/sys/class/block}
systemctl=${NBD_MONITOR_SYSTEMCTL:-/usr/bin/systemctl}
notify=${NBD_MONITOR_NOTIFY:-/usr/bin/systemd-notify}
readonly heartbeat_interval=1000 close_interval=500 request_window=200 close_window=15000 retry_interval=100

log() { printf 'nbd-monitor device=%s session=%s %s\n' "${device:--}" "${session:--}" "$*" >&2; }
die() { log "$*"; exit 1; }
valid_id() { [[ $1 =~ ^[a-f0-9]{32}$ ]]; }
valid_port() { [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 <= 65535 && $1 != 11120 )); }

tick() {
    local uptime
    read -r uptime _ < /proc/uptime
    now=$((10#${uptime%.*} * 100 + 10#${uptime#*.}))
}

check_config() {
    local line section='' control_port=''
    client_id=
    local assignment='^[[:blank:]]*([a-z_]+)[[:blank:]]*=[[:blank:]]*([a-zA-Z0-9_.-]+)[[:blank:]]*$'
    [[ -r $config ]] || die "config_unreadable"
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^[[:blank:]]*([#;].*)?$ ]]; then continue; fi
        if [[ $line == '[global]' ]]; then section=global; continue; fi
        [[ $section == global && $line =~ $assignment ]] || die "invalid_config"
        case ${BASH_REMATCH[1]} in
            client_id)
                [[ -z $client_id ]] || die "duplicate_client_id"
                client_id=${BASH_REMATCH[2]} ;;
            control_port)
                [[ -z $control_port && ${BASH_REMATCH[2]} == 11120 ]] || die "invalid_control_port"
                control_port=11120 ;;
            *) die "unknown_config_key" ;;
        esac
    done < "$config"
    [[ $client_id =~ ^[a-zA-Z0-9_.-]{1,128}$ ]] || die "invalid_client_id"
}

load_nbdtab() {
    local line option count=0 port_seen=no
    local -a fields=() options=()
    [[ -r $nbdtab ]] || die "nbdtab_unreadable"
    port=10809
    while IFS= read -r line || [[ -n $line ]]; do
        read -r -a fields <<< "${line%%\#*}"
        [[ ${fields[0]:-} == "$device" ]] || continue
        (( count += 1 ))
        (( ${#fields[@]} == 3 || ${#fields[@]} == 4 )) || die "invalid_nbdtab"
        host=${fields[1]} export_name=${fields[2]}
        IFS=, read -r -a options <<< "${fields[3]:-}"
        for option in "${options[@]}"; do
            case $option in
                port=*)
                    [[ $port_seen == no ]] || die "duplicate_data_port"
                    port_seen=yes port=${option#port=} ;;
                timeout=*|bs=*|no_optgo) ;;
                *) die "unsupported_nbdtab_option=$option" ;;
            esac
        done
    done < "$nbdtab"
    (( count == 1 )) || die "invalid_nbdtab_device_count"
    [[ $host =~ ^[a-zA-Z0-9_.-]{1,253}$ && $export_name =~ ^[a-zA-Z0-9_.-]{1,128}$ ]] ||
        die "invalid_nbd_endpoint"
    valid_port "$port" || die "invalid_data_port"
}

save_local() {
    local file=$1 temporary
    shift
    temporary=$(mktemp -- "$directory/.state.XXXXXXXX") || return 1
    if ! printf '%s\n' "$@" > "$temporary" || ! mv -fT -- "$temporary" "$directory/$file"; then
        rm -f -- "$temporary"
        return 1
    fi
}

load_context() {
    local -a lines=()
    [[ -r $directory/context ]] || return 1
    mapfile -t lines < "$directory/context"
    (( ${#lines[@]} == 6 )) || return 1
    owner=${lines[0]} native_id=${lines[1]} session=${lines[2]}
    host=${lines[3]} port=${lines[4]} admission=${lines[5]}
    valid_id "$owner" && valid_id "$native_id" && valid_id "$session" &&
        [[ $host =~ ^[a-zA-Z0-9_.-]{1,253}$ ]] && valid_port "$port"
}

marker() {
    local id
    [[ -r $directory/$1 ]] && read -r id < "$directory/$1" && [[ $id == "$native_id" ]]
}

sample_device() {
    local path=$sysfs/$device
    [[ -d $path ]] && IFS= read -r size 2>/dev/null < "$path/size" &&
        [[ $size =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    pid=-
    if [[ -e $path/pid || -L $path/pid ]]; then
        IFS= read -r pid 2>/dev/null < "$path/pid" && [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
    fi
    [[ -d $path && -r $path/size ]]
}

device_status() {
    local size pid first_size first_pid
    observed_device=unknown
    sample_device || return 0
    first_size=$size first_pid=$pid
    sample_device || return 0
    [[ $size == "$first_size" && $pid == "$first_pid" ]] || return 0
    if [[ $size == 0 && $pid == - ]]; then
        observed_device=disconnected
    elif [[ $size != 0 && $pid != - ]]; then
        observed_device=connected
    fi
}

native_stop_status() {
    local snapshot line stop='' invocation='' query_started query_rc
    local record='^\{ path=/usr/sbin/nbd-client ; argv\[\]=/usr/sbin/nbd-client -d /dev/'"$device"' ; ignore_errors=(yes|no) ; start_time=\[([^]]+)\] ; stop_time=\[([^]]+)\] ; pid=([0-9]+) ; code=([^ ;]+) ; status=([^ ;]+) \}$'
    local timestamp='^[A-Z][a-z]{2} [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}( [^[:cntrl:]]+)?$'
    native=unknown native_code=- native_status=-
    # Use the manager's native IPC timeout and the outer stop protection.
    tick
    query_started=$now
    if snapshot=$("$systemctl" show -p InvocationID -p ExecStop "nbd@$device.service"); then
        tick
        native_query_cs=$((now - query_started))
    else
        query_rc=$?
        tick
        native_query_cs=$((now - query_started))
        log "event=native_stop_query_failed rc=$query_rc elapsed_cs=$native_query_cs"
        return 0
    fi
    while IFS= read -r line; do
        case $line in
            InvocationID=*) invocation=${line#*=} ;;
            ExecStop=*) stop=${line#*=} ;;
        esac
    done <<< "$snapshot"
    [[ $invocation == "$native_id" ]] || { log "event=native_stop_record_rejected reason=invocation_mismatch"; return 0; }
    [[ $stop =~ $record ]] || { log "event=native_stop_record_rejected reason=record_mismatch"; return 0; }
    local started=${BASH_REMATCH[2]} stopped=${BASH_REMATCH[3]} stop_pid=${BASH_REMATCH[4]}
    native_code=${BASH_REMATCH[5]} native_status=${BASH_REMATCH[6]}
    if [[ $started == n/a && $stopped == n/a && $stop_pid == 0 && $native_code == '(null)' &&
          ( $native_status == 0 || $native_status == 0/0 ) ]]; then
        native=not_executed
    elif [[ $started =~ $timestamp && $stopped =~ $timestamp && $stop_pid =~ ^[1-9][0-9]*$ &&
            $native_status =~ ^(0|[1-9][0-9]*)(/[a-zA-Z0-9_+-]+)?$ ]]; then
        case $native_code in
            exited) if [[ ${native_status%%/*} == 0 ]]; then native=success; else native=failed; fi ;;
            killed|dumped) if [[ ${native_status%%/*} != 0 ]]; then native=signaled; fi ;;
        esac
    fi
    [[ $native != unknown ]] || log "event=native_stop_record_rejected reason=unclassified_record"
}

control() {
    local budget=$1 verb=$2 line status
    shift 2
    local -a response=()
    local duration
    printf -v duration '%d.%02ds' "$((budget / 100))" "$((budget % 100))"
    control_fault=control_error
    control_class=local_error
    reply_reason=-
    # The timed child owns the TCP socket; distinguish transport from protocol failure.
    # shellcheck disable=SC2016
    if line=$(timeout "$duration" bash -c '
        exec 3<>"/dev/tcp/$1/11120" || exit 10
        shift
        printf "%s\n" "$*" >&3 || exit 10
        IFS= read -r -n 513 reply <&3 || exit 10
        (( ${#reply} <= 512 )) || exit 11
        printf "%s" "$reply" || exit 12
    ' bash "$host" 1 "$verb" "$port" "$session" "$@"); then
        control_class=protocol
        read -r -a response <<< "$line"
        (( ${#response[@]} == 5 )) && [[ ${response[0]} == 1 && ${response[2]} == "$session" &&
            ${response[4]} =~ ^[a-z_-]+$ ]] || return 1
        reply=${response[1]} reply_run=${response[3]} reply_reason=${response[4]}
        [[ $reply_run == - ]] || valid_id "$reply_run" || return 1
        control_class=none
    else
        status=$?
        case $status in
            10|141) control_class=transport ;;
            11) control_class=protocol ;;
            124) control_class=timeout; control_fault=control_timeout ;;
            137) control_fault=control_timeout ;; # Preserve legacy reason; unexplained SIGKILL is not retryable.
        esac
        return 1
    fi
}

new_session() {
    read -r session < /proc/sys/kernel/random/uuid
    session=${session//-/}
    valid_id "$session" || die "session_unavailable"
}

admit() {
    local owner attempts=1
    read -r owner < "$directory/monitor" || die "monitor_not_ready"
    valid_id "$owner" || die "invalid_monitor_invocation"
    check_config
    load_nbdtab
    device_status
    [[ $observed_device == disconnected ]] || die "device_not_confirmed_free"
    if (load_context && [[ $native_id == "$INVOCATION_ID" ]]); then die "invocation_already_attempted"; fi
    new_session
    save_local context "$owner" "$INVOCATION_ID" "$session" "$host" "$port" pending
    # ExecStartPre is bounded by the existing systemd TimeoutStartSec.
    # Retry only unconfirmed transport; never renew or replace this Session.
    while ! control "$request_window" admit "$export_name" "$client_id"; do
        if [[ $control_class != transport && $control_class != timeout ]]; then
            if (( attempts > 1 )); then
                log "event=admit_retry_stopped attempts=$attempts reason=$control_fault class=$control_class"
            fi
            die "admission_$control_fault"
        fi
        if (( attempts == 1 )); then
            log "event=admit_retry_begin reason=$control_fault"
        fi
        sleep 1
        (( attempts += 1 ))
    done
    if [[ $reply != admitted || $reply_run != - || $reply_reason != - ]]; then
        if (( attempts > 1 )); then
            log "event=admit_retry_stopped attempts=$attempts reply=$reply reason=$reply_reason"
        fi
        die "admission_denied=$reply_reason"
    fi
    save_local context "$owner" "$INVOCATION_ID" "$session" "$host" "$port" admitted
    if (( attempts > 1 )); then
        log "event=admit_retry_recovered attempts=$attempts"
    fi
    log "event=admitted client=$client_id native_invocation=$INVOCATION_ID port=$port"
}

observe_start() {
    load_context && [[ $native_id == "$INVOCATION_ID" && $admission == admitted ]] || return 0
    save_local online "$native_id"
}

observe_stop() {
    local native_query_cs=-
    save_local stopping "$native_id" || die "stopping_save_failed"
    native_stop_status
    device_status
    save_local stopped "$native_id" "$native" "$observed_device" || die "stopped_save_failed"
    log "event=native_stop native_invocation=$native_id native=$native code=$native_code status=$native_status device=$observed_device query_cs=$native_query_cs"
}

heartbeat_allowed() {
    load_context && [[ $owner == "$INVOCATION_ID" && $admission == admitted ]] &&
        marker online && ! marker stopping && ! marker closing
}

run() {
    local next_heartbeat=0 last_native='' run_id='' bound=no failures=0 last_error='' detail
    save_local monitor "$INVOCATION_ID"
    "$notify" --ready
    while :; do
        if heartbeat_allowed; then
            if [[ $last_native != "$native_id" ]]; then
                next_heartbeat=0 last_native=$native_id run_id= bound=no failures=0 last_error=
            fi
            tick
            if (( now >= next_heartbeat )); then
                next_heartbeat=$((now + heartbeat_interval))
                detail=-
                if ! control "$request_window" heartbeat; then
                    detail="$control_class:$control_fault"
                elif [[ $reply == failed || $reply == rejected ]]; then
                    detail="$reply:$reply_reason"
                elif [[ ( $reply != active && $reply != closing ) || $reply_reason != - ]] ||
                    ! valid_id "$reply_run"; then
                    detail=invalid_reply
                elif [[ -n $run_id && $run_id != "$reply_run" ]]; then
                    detail=run_mismatch
                else
                    run_id=$reply_run
                    # A single atomic, optional identity snapshot. Never replace a known Run.
                    # A response arriving after stopping is not needed by finalize.
                    if [[ $bound == no ]] && ! marker stopping && ! marker closing; then
                        if save_local binding "$native_id" "$run_id"; then
                            bound=yes
                            log "event=heartbeat_bound run=$run_id"
                        else
                            log "event=heartbeat_observation_error reason=binding_save_failed run=$run_id"
                        fi
                    fi
                fi
                if [[ $detail != - ]]; then
                    (( failures += 1 ))
                    if [[ $detail != "$last_error" ]]; then
                        log "event=heartbeat_degraded detail=$detail failures=$failures run=${run_id:--}"
                    fi
                    last_error=$detail
                elif (( failures > 0 )); then
                    log "event=heartbeat_recovered failures=$failures run=$run_id"
                    failures=0 last_error=
                fi
            fi
        fi
        sleep 1
    done
}

record_final() {
    local result=$1 reason=$2 run=$3 native=$4 observed_device=$5
    save_local final "$native_id" "$session" "$run" "$result" "$reason" "$native" "$observed_device" ||
        die "final_save_failed"
    if [[ $result == normal ]]; then
        log "event=exit result=normal run=$run native=$native device=$observed_device"
        return 0
    fi
    log "event=exit result=failed reason=$reason run=$run native=$native device=$observed_device"
    return 1
}

# Local lock waits share the existing finalize budget, not independent short limits.
wait_local_lock() {
    local fd=$1 limit=$2 remaining duration
    tick
    remaining=$((limit - now))
    (( remaining > 0 )) || return 1
    printf -v duration '%d.%02d' "$((remaining / 100))" "$((remaining % 100))"
    flock -w "$duration" "$fd"
}

finalize() {
    local deadline native=unknown observed_device=unknown expected_run='' reason buffer=50
    local close_fd
    local -a saved=()
    tick
    deadline=$((now + close_window))
    exec {close_fd}>"$directory/close.lock"
    wait_local_lock "$close_fd" "$deadline" || die "finalize_lock_timeout"
    if [[ ! -e $directory/context ]]; then
        log "event=finalize_skipped reason=no_context"
        return 0
    fi
    load_context || die "invalid_context"
    if [[ $native_id != "$INVOCATION_ID" ]]; then
        log "event=finalize_skipped reason=other_invocation"
        return 0
    fi
    if [[ -r $directory/final ]]; then
        mapfile -t saved < "$directory/final"
        if (( ${#saved[@]} == 7 )) && [[ ${saved[0]} == "$native_id" && ${saved[1]} == "$session" ]]; then
            [[ ${saved[3]} == normal ]]
            return
        fi
    fi
    observe_stop
    if [[ $admission != admitted ]]; then
        record_final failed admission_unconfirmed - "$native" "$observed_device"
        return
    fi
    if marker closing; then
        record_final failed close_incomplete - "$native" "$observed_device"
        return
    fi
    save_local closing "$native_id" || die "closing_save_failed"
    # Read an already-published atomic identity snapshot, never wait for observation.
    # Close/confirm still independently validate Session and Run.
    if [[ -r $directory/binding ]] && mapfile -t saved < "$directory/binding" &&
        (( ${#saved[@]} == 2 )) && [[ ${saved[0]} == "$native_id" ]] &&
        valid_id "${saved[1]}"; then
        expected_run=${saved[1]}
    fi

    local verb=close attempts=0 retry_pending=no retry_exhausted=no
    local -a payload=("$native" "$observed_device" -)
    reason=close_timeout
    while :; do
        tick
        if (( deadline - now <= request_window + buffer )); then
            if [[ $retry_pending == yes ]]; then retry_exhausted=yes; fi
            break
        fi
        (( attempts += 1 ))
        if ! control "$request_window" "$verb" "${payload[@]}"; then
            reason=$control_fault
            if [[ $control_class != transport && $control_class != timeout ]]; then
                break
            fi
            tick
            if (( deadline - now <= retry_interval + request_window + buffer )); then
                retry_exhausted=yes
                break
            fi
            if [[ $retry_pending == no ]]; then
                log "event=${verb}_retry_begin reason=$reason run=${expected_run:--} remaining_cs=$((deadline - now))"
            fi
            retry_pending=yes
            sleep 1
            continue
        fi
        tick
        if (( now >= deadline )); then
            if [[ $retry_pending == yes ]]; then retry_exhausted=yes; fi
            break
        fi
        if [[ $reply == failed || $reply == rejected ]]; then
            reason=$reply_reason
            break
        fi
        if ! valid_id "$reply_run" || [[ -n $expected_run && $expected_run != "$reply_run" ]]; then
            reason=run_mismatch
            break
        fi
        case $verb:$reply in
            close:waiting|close:ready|confirm:complete)
                [[ $reply_reason == - ]] || { reason=unexpected_reply; break; } ;;
            *) reason=unexpected_reply; break ;;
        esac
        expected_run=$reply_run
        if [[ $retry_pending == yes ]]; then
            log "event=${verb}_retry_recovered attempts=$attempts run=$expected_run"
        fi
        # A validated reply ends this retry episode; ordinary polling is not retrying.
        attempts=0 retry_pending=no reason=close_timeout
        case $verb:$reply in
            close:waiting)
                (( deadline - now > close_interval + request_window + buffer )) || break
                sleep 5 ;;
            close:ready)
                verb=confirm
                payload=("$expected_run") ;;
            confirm:complete)
                record_final normal - "$expected_run" "$native" "$observed_device"
                return 0 ;;
        esac
    done
    if [[ $retry_exhausted == yes ]]; then
        log "event=${verb}_retry_exhausted attempts=$attempts last_fault=$reason run=${expected_run:--}"
    elif [[ $retry_pending == yes ]]; then
        log "event=${verb}_retry_stopped attempts=$attempts reason=$reason run=${expected_run:--}"
    fi
    record_final failed "$reason" "${expected_run:--}" "$native" "$observed_device"
}

report() {
    check_config
    load_nbdtab
    new_session
    control "$request_window" status || die "$control_fault"
    case $reply in
        available|unavailable)
            printf 'port=%s status=%s reason=%s\n' "$port" "$reply" "$reply_reason" ;;
        *) die "status_rejected=$reply_reason" ;;
    esac
}

usage() { printf '%s\n' 'usage: nbd-monitor run|admit|observe-start|finalize|report DEVICE'; }

case ${1:-} in
    --version) printf '%s\n' 'nbd-monitor 0.0.7'; exit ;;
    --help|-h) usage; exit ;;
    run|admit|observe-start|finalize|report)
        (( $# == 2 )) || die "invalid_arguments"
        [[ $2 =~ ^nbd(0|[1-9][0-9]*)$ ]] || die "invalid_device" ;;
    *) usage >&2; exit 1 ;;
esac
device=$2
if [[ $1 == report ]]; then report; exit; fi
valid_id "${INVOCATION_ID:-}" || die "missing_invocation"
directory=$runtime/$device
mkdir -p -- "$directory"
case $1 in
    run) run ;;
    admit) admit ;;
    observe-start) observe_start ;;
    finalize) finalize ;;
esac
