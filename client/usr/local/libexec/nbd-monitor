#!/bin/bash
# nbd-monitor v0.4.2-P1-R-B (development) - local exit observation; original v0.4 behavior retained
# 仅支持 TCP nbdtab、单客户端单连接、普通文件系统测试；不支持 swap。
# Type=notify 在 previous 完成后、真实数据连接前报告 READY。
# 原生 nbd@ 先停止，monitor ExecStop=disconnect 随后核验；仅显式启用后有限补做 detach。

set -euo pipefail
umask 077
export LC_ALL=C

log() { printf 'nbd-monitor: %s\n' "$*" >&2; }
die() { failure_reason=$*; log "错误：$*"; exit 1; }

# P1 observation layer. All entry points are best-effort; never used for
# device_status, detach authorization, protocol replies or session transitions.
# No new persistent files, no remote reports, no BPF.
declare -A obs_call_status=()
obs_uuid() { local u; IFS= read -r u < /proc/sys/kernel/random/uuid && printf '%s' "$u"; }
obs_escape() {
    local v=$1
    v=${v//\\/\\\\}; v=${v//$'\r'/\\r}; v=${v//$'\n'/\\n}; v=${v//$'\t'/\\t}
    printf '%s' "$v"
}
obs_clock() {
    obs_epoch=${EPOCHREALTIME:-unknown}
    obs_tick=unknown
    if IFS=' ' read -r obs_tick _ < /proc/uptime; then :; else obs_tick=unknown; fi
}
# Structured journal submission is not a durability acknowledgement. Raw text
# is escaped to one line; field names are internal constants, never input data.
obs_emit() {
    local phase=$1 stage=$2 event=$3 item key val payload eid
    shift 3
    obs_clock
    eid=$(obs_uuid) || eid=unknown
    printf -v payload '%s\n' \
        'SYSLOG_IDENTIFIER=nbd-monitor' 'PRIORITY=6' 'NBD_SCHEMA=1' \
        "NBD_CLIENT=$(obs_escape "${client_id:-unknown}")" \
        "NBD_DEVICE=${dev:-unknown}" "NBD_BOOT_ID=${boot_id:-unknown}" \
        "NBD_SESSION=${session:-unknown}" "NBD_OBSERVATION_ID=${obs_id:-unknown}" \
        "NBD_EVENT_ID=$eid" "NBD_PHASE=$phase" "NBD_STAGE=$stage" "NBD_EVENT=$event" \
        "NBD_EVENT_EPOCH=$obs_epoch" "NBD_EVENT_TICK=$obs_tick" \
        "MESSAGE=nbd-monitor ${dev:-unknown} $stage $event session=${session:-unknown}"
    for item in "$@"; do
        key=${item%%=*}; val=${item#*=}
        [[ $key =~ ^[A-Z][A-Z0-9_]*$ && $item == *=* ]] || continue
        payload+="NBD_$key=$(obs_escape "$val")"$'\n'
    done
    if printf '%s' "$payload" | timeout --foreground --signal=TERM --kill-after=0.1s 0.25s \
        "${NBD_MONITOR_OBS_LOGGER:-/usr/bin/logger}" --journald >/dev/null 2>&1; then
        return 0
    fi
    # Fallback uses the original systemd stderr channel, preserves evidence.
    if [[ -n ${run_dir:-} && -d $run_dir ]]; then
        obs_atomic "$run_dir/observation.fallback" "${payload:0:60000}" 2>/dev/null || :
    fi
    printf 'nbd-monitor: journal_submit_failed %s\n' "$(obs_escape "$payload")" >&2 || :
    return 0
}
obs_atomic() {
    local path=$1 tmp
    shift
    tmp="$path.tmp.$BASHPID"
    if printf '%s\n' "$@" > "$tmp" && mv -f -- "$tmp" "$path"; then return 0; fi
    rm -f -- "$tmp" 2>/dev/null || :
    return 1
}
# Read only whitelisted keys; no source/eval. An observation context is not an
# authorization token. Never use stale context to select an old session.
obs_read_context() {
    local line key value
    declare -gA obs_ctx=()
    [[ -r $run_dir/observation.state ]] || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == *=* ]] || return 1
        key=${line%%=*}; value=${line#*=}
        case $key in id|boot|client|session|host|port|export|invocation) ;; *) return 1 ;; esac
        [[ ! ${obs_ctx[$key]+x} ]] || return 1
        obs_ctx[$key]=$value
    done < "$run_dir/observation.state"
    for key in id boot client session host port export invocation; do
        [[ ${obs_ctx[$key]+x} ]] || return 1
    done
    local uuid_re='^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$'
    [[ $boot_id =~ $uuid_re && ${obs_ctx[id]} =~ $uuid_re && ${obs_ctx[boot]} == "$boot_id" ]] || return 1
    [[ ${obs_ctx[session]} == unknown || ${obs_ctx[session]} =~ $uuid_re ]] || return 1
    [[ ${obs_ctx[port]} =~ ^[0-9]{1,5}$ ]] || return 1
    [[ ${obs_ctx[invocation]} == unknown ]] || obs_valid_invocation "${obs_ctx[invocation]}" || return 1
}
obs_write_context() {
    obs_atomic "$run_dir/observation.state" \
        "id=$obs_id" "boot=$boot_id" "client=$client_id" "session=${session:-unknown}" \
        "host=$data_host" "port=$data_port" "export=$data_export" "invocation=${obs_invocation:-unknown}"
}
obs_context_matches() {
    obs_read_context && [[ ${obs_ctx[client]} == "$client_id" && ${obs_ctx[session]} == "${session:-unknown}" && \
        ${obs_ctx[host]} == "$data_host" && ${obs_ctx[port]} == "$data_port" && ${obs_ctx[export]} == "$data_export" ]]
}
# Observation-only identity helpers. The existing observation.state schema
# remains unchanged; new sidecars are scoped by observation/boot/session.
obs_valid_invocation() {
    [[ $1 =~ ^[0-9a-fA-F]{32}$ && $1 != 00000000000000000000000000000000 ]]
}
obs_read_fields() {
    local -n dest=$1
    shift
    local line key
    dest=()
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == *=* ]] || return 1
        key=${line%%=*}
        [[ $key =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ && " $* " == *" $key "* ]] || return 1
        [[ ! ${dest[$key]+x} ]] || return 1
        dest[$key]=${line#*=}
    done
    for key in "$@"; do [[ ${dest[$key]+x} ]] || return 1; done
}
# Observation only: read the same sysfs attributes used by nbd-client 3.26.1.
# No external command, no network probe, no authorization to detach.
obs_sample_nbd_sysfs() {
    local path=$1 value
    obs_sysfs_size=unknown; obs_sysfs_pid=unknown; obs_sysfs_pid_state=unknown
    [[ -d $path && -x $path && -r $path/size ]] || return 1
    IFS= read -r value 2>/dev/null < "$path/size" || return 1
    [[ $value =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    obs_sysfs_size=$value
    if [[ -e $path/pid || -L $path/pid ]]; then
        obs_sysfs_pid_state=unreadable
        IFS= read -r value 2>/dev/null < "$path/pid" || return 1
        obs_sysfs_pid_state=invalid
        [[ $value =~ ^[1-9][0-9]*$ ]] || return 1
        obs_sysfs_pid=$value; obs_sysfs_pid_state=present
    else
        obs_sysfs_pid_state=absent
    fi
    [[ -d $path && -x $path && -r $path/size ]]
}
obs_read_nbd_state() {
    local path="${NBD_MONITOR_SYS_CLASS_BLOCK:-/sys/class/block}/$dev"
    local first_size first_pid first_state
    obs_sysfs_status=unknown; obs_sysfs_reason=sample_unverified
    obs_sample_nbd_sysfs "$path" || return 0
    first_size=$obs_sysfs_size; first_pid=$obs_sysfs_pid; first_state=$obs_sysfs_pid_state
    obs_sample_nbd_sysfs "$path" || return 0
    if [[ $first_size != "$obs_sysfs_size" || $first_pid != "$obs_sysfs_pid" || $first_state != "$obs_sysfs_pid_state" ]]; then
        obs_sysfs_reason=sample_changed; return 0
    fi
    if [[ $obs_sysfs_size == 0 && $obs_sysfs_pid_state == absent ]]; then
        obs_sysfs_status=disconnected; obs_sysfs_reason=consistent_sample
    elif [[ $obs_sysfs_size != 0 && $obs_sysfs_pid_state == present ]]; then
        obs_sysfs_status=connected; obs_sysfs_reason=consistent_sample
    else obs_sysfs_reason=contradictory_sample; fi
}
# Reuse the pre-READY worker's existing outer budget. No evidence means no
# automatic binding, not a new startup condition.
obs_preconnect() {
    local reason obs_sysfs_size=unknown obs_sysfs_pid=unknown obs_sysfs_pid_state=unknown
    local obs_sysfs_status=not_sampled obs_sysfs_reason=not_sampled
    if [[ $obs_context_ok != yes || $session != unknown ]]; then reason=context_unverified
    elif [[ $obs_locked != yes ]]; then reason=observation_lock_busy
    elif ! obs_valid_invocation "${INVOCATION_ID:-unknown}"; then reason=monitor_invocation_invalid
    else
        obs_read_nbd_state
        if [[ $obs_sysfs_status == connected ]]; then reason=connection_already_present
        elif [[ $obs_sysfs_status != disconnected ]]; then reason=sysfs_state_unverified
        elif ! obs_context_matches || [[ ${obs_ctx[id]} != "$obs_id" ]]; then reason=context_changed
        elif obs_atomic "$run_dir/observation.preconnect" "id=$obs_id" "boot=$boot_id" "monitor_invocation=$INVOCATION_ID"; then reason=written
        else reason=anchor_write_failed; fi
    fi
    # Publish the anchor before any best-effort journal submission.
    obs_emit "$obs_phase" "$obs_stage" native_preconnect_observed "PRECONNECT_REASON=$reason" "PRECONNECT_CHECK_RC=not_executed" "PRECONNECT_SIZE_SECTORS=$obs_sysfs_size" "MONITOR_INVOCATION_ID=${INVOCATION_ID:-unknown}" "CHECK_SOURCE=sysfs" "SYSFS_DEVICE_STATUS=$obs_sysfs_status" "SYSFS_PID_STATE=$obs_sysfs_pid_state" "SYSFS_PID=$obs_sysfs_pid" "SYSFS_REASON=$obs_sysfs_reason" || :
    return 0
}
obs_binding_connection() {
    local -A st=() conn=()
    obs_sysfs_size=unknown; obs_sysfs_pid=unknown; obs_sysfs_pid_state=unknown
    obs_sysfs_status=not_sampled; obs_sysfs_reason=context_unverified
    obs_read_fields st client host port export session boot phase 2>/dev/null < "$run_dir/session.state" || return 1
    [[ ${st[client]} == "$client_id" && ${st[host]} == "$data_host" && ${st[port]} == "$data_port" && ${st[export]} == "$data_export" && ${st[session]} == "$session" && ${st[boot]} == "$boot_id" && ${st[phase]} == running ]] || return 1
    obs_read_fields conn session pid 2>/dev/null < "$run_dir/connection.state" || return 1
    [[ ${conn[session]} == "$session" && ${conn[pid]} =~ ^[1-9][0-9]*$ ]] || return 1
    obs_read_nbd_state
    [[ $obs_sysfs_status == connected && $obs_sysfs_pid == "${conn[pid]}" ]]
}
obs_binding_note() {
    local reason=$1 rc=$2 candidate=$3 bound=$4 previous= line
    if [[ -r $run_dir/observation.bind-status ]]; then
        IFS= read -r previous < "$run_dir/observation.bind-status" || :
    fi
    line="$obs_id $reason $rc $candidate $bound"
    [[ $line != "$previous" ]] || return 0
    local retry=yes
    if [[ $reason == preconnect_unverified || $bound != unknown ]]; then retry=no; fi
    # Preserve the retry decision even if logging consumes the remaining budget.
    obs_atomic "$run_dir/observation.bind-status" "$line" || :
    obs_emit "$obs_phase" "$obs_stage" native_invocation_binding "BIND_REASON=$reason" "BIND_RETRY=$retry" "QUERY_RC=$rc" "CANDIDATE_INVOCATION_ID=$candidate" "NATIVE_INVOCATION_ID=$bound" "CHECK_SOURCE=sysfs" "SYSFS_DEVICE_STATUS=${obs_sysfs_status:-not_sampled}" "SYSFS_PID_STATE=${obs_sysfs_pid_state:-unknown}" "SYSFS_PID=${obs_sysfs_pid:-unknown}" "SYSFS_SIZE_SECTORS=${obs_sysfs_size:-unknown}" "SYSFS_REASON=${obs_sysfs_reason:-not_sampled}" || :
}
# A missing/invalid pre-READY anchor cannot be recreated for this observation.
obs_binding_retryable() {
    local id= reason= rest=
    if IFS=' ' read -r id reason rest 2>/dev/null < "$run_dir/observation.bind-status" &&
       [[ $id == "$obs_id" && $reason == preconnect_unverified ]]; then return 1; fi
    return 0
}
obs_bind_invocation() {
    local -A anchor=() native=() monitor=()
    local raw rc=0 first first_size candidate=unknown old
    local obs_sysfs_size=unknown obs_sysfs_pid=unknown obs_sysfs_pid_state=unknown
    local obs_sysfs_status=not_sampled obs_sysfs_reason=not_sampled
    [[ $obs_context_ok == yes && $obs_locked == yes && $session != unknown ]] || return 0
    obs_context_matches && [[ ${obs_ctx[id]} == "$obs_id" ]] || return 0
    old=${obs_ctx[invocation]}
    if [[ $old == unknown ]]; then
        if ! obs_read_fields anchor id boot monitor_invocation 2>/dev/null < "$run_dir/observation.preconnect" ||
           [[ ${anchor[id]:-} != "$obs_id" || ${anchor[boot]:-} != "$boot_id" || ${anchor[monitor_invocation]:-} != "${INVOCATION_ID:-unknown}" ]] ||
           ! obs_valid_invocation "${INVOCATION_ID:-unknown}"; then
            obs_binding_note preconnect_unverified unknown unknown "$old"; return 0
        fi
        if ! obs_binding_connection; then obs_binding_note connection_unverified unknown unknown "$old"; return 0; fi
        first=$obs_sysfs_pid; first_size=$obs_sysfs_size
    fi
    raw=$(timeout --foreground --kill-after=0.1s 0.4s "$systemctl_bin" show --all -p InvocationID -p ActiveState -p SubState -p ExecMainStartTimestampMonotonic "nbd@$dev.service" 2>/dev/null) || rc=$?
    if ((rc != 0)); then obs_binding_note native_query_failed "$rc" unknown "$old"; return 0; fi
    if ! obs_read_fields native InvocationID ActiveState SubState ExecMainStartTimestampMonotonic <<< "$raw" || ! obs_valid_invocation "${native[InvocationID]:-unknown}"; then
        obs_binding_note native_identity_unavailable 0 unknown "$old"; return 0
    fi
    candidate=${native[InvocationID]}
    if [[ $old != unknown ]]; then
        if [[ $old != "$candidate" ]]; then obs_binding_note invocation_conflict 0 "$candidate" "$old"; fi
        return 0
    fi
    if [[ ${native[ActiveState]} != active || ${native[SubState]} != exited || ! ${native[ExecMainStartTimestampMonotonic]} =~ ^[1-9][0-9]{0,17}$ ]]; then
        obs_binding_note native_not_confirmed_active 0 "$candidate" "$old"; return 0
    fi
    rc=0
    raw=$(timeout --foreground --kill-after=0.1s 0.4s "$systemctl_bin" show --all -p InvocationID -p ExecMainStartTimestampMonotonic "nbd-monitor@$dev.service" 2>/dev/null) || rc=$?
    if ((rc != 0)); then obs_binding_note monitor_query_failed "$rc" "$candidate" "$old"; return 0; fi
    if ! obs_read_fields monitor InvocationID ExecMainStartTimestampMonotonic <<< "$raw" ||
       [[ ${monitor[InvocationID]:-} != "$INVOCATION_ID" || ! ${monitor[ExecMainStartTimestampMonotonic]:-} =~ ^[1-9][0-9]{0,17}$ ]] ||
       (( native[ExecMainStartTimestampMonotonic] <= monitor[ExecMainStartTimestampMonotonic] )); then
        obs_binding_note native_start_unverified 0 "$candidate" "$old"; return 0
    fi
    if ! obs_binding_connection || [[ $first != "$obs_sysfs_pid" || $first_size != "$obs_sysfs_size" ]] || ! obs_context_matches ||
       [[ ${obs_ctx[id]} != "$obs_id" || ${obs_ctx[invocation]} != unknown ]]; then
        obs_binding_note context_or_connection_changed 0 "$candidate" "$old"; return 0
    fi
    obs_invocation=$candidate
    if obs_write_context; then
        obs_ctx[invocation]=$candidate
        obs_binding_note bound 0 "$candidate" "$candidate"
    else obs_binding_note context_write_failed 0 "$candidate" "$old"; fi
}
# Hook association and native fact validation deliberately have separate results.
obs_hook_context() {
    client_id=unknown; session=unknown; obs_id=unknown; data_host=unknown; data_port=unknown; data_export=unknown
    obs_context_ok=no; obs_context_reason=context_unavailable
    if ! obs_valid_invocation "${INVOCATION_ID:-unknown}"; then obs_context_reason=hook_invocation_invalid
    elif obs_read_context; then
        if [[ ${obs_ctx[invocation]} == unknown ]]; then obs_context_reason=context_invocation_unknown
        elif [[ ${obs_ctx[session]} == unknown ]]; then obs_context_reason=context_session_unknown
        elif [[ ${obs_ctx[invocation]} != "$INVOCATION_ID" ]]; then obs_context_reason=invocation_mismatch
        else
            client_id=${obs_ctx[client]}; session=${obs_ctx[session]}; obs_id=${obs_ctx[id]}
            data_host=${obs_ctx[host]}; data_port=${obs_ctx[port]}; data_export=${obs_ctx[export]}
            obs_context_ok=yes; obs_context_reason=matched
        fi
    fi
    return 0
}
# Worker has its own finite lifetime. No original business locks are acquired.
obs_call() {
    local budget=$1 action=$2 stage=$3 phase=$4 rc=0
    (
        # Do not inherit business lock descriptors into the observation worker.
        [[ -z ${agent_fd:-} ]] || exec {agent_fd}>&-
        [[ -z ${run_fd:-} ]] || exec {run_fd}>&-
        export NBD_OBS_CLIENT=${client_id:-unknown} NBD_OBS_SESSION=${session:-unknown}
        export NBD_OBS_ID=${obs_id:-unknown} NBD_OBS_HOST=${data_host:-unknown} NBD_OBS_PORT=${data_port:-unknown}
        export NBD_OBS_EXPORT=${data_export:-unknown}
        exec timeout --signal=TERM --kill-after=0.2s "$budget" "$0" _observe "$dev" "$action" "$stage" "$phase"
    ) || rc=$?
    # Suppress repeated identical runtime worker failures, but record changes.
    local previous=${obs_call_status[$action]:-0}
    local -a hook_fields=()
    if [[ $action == hook ]]; then hook_fields=("NATIVE_INVOCATION_ID=${INVOCATION_ID:-unknown}" "CONTEXT_MATCH=${obs_context_ok:-no}" "CONTEXT_REASON=${obs_context_reason:-unknown}"); fi
    if ((rc != 0)); then
        if [[ $phase != runtime || $previous != "$rc" ]]; then
            obs_emit "$phase" "$stage" observation_worker_failed "WORKER_RC=$rc" "ACTION=$action" "${hook_fields[@]}" || :
        fi
    elif [[ $previous != 0 ]]; then
        obs_emit "$phase" "$stage" observation_worker_recovered "ACTION=$action" || :
    fi
    obs_call_status[$action]=$rc
    return 0
}
obs_attr() {
    local path=$1 v
    if [[ ! -e $path ]]; then printf 'not_exposed'; return; fi
    if IFS= read -r v < "$path"; then printf '%s' "$v"; else printf 'unknown'; fi
}
# Observation only. Never resolve a mount target or open a block device.
# Keep mountinfo's kernel-escaped root/target/source in evidence records.
obs_mount_source_id() {
    local source=$1 blocks=$2 devroot=$3 name link dir leaf
    source=${source//\\040/ }; source=${source//\\011/$'\t'}
    source=${source//\\012/$'\n'}; source=${source//\\134/\\}
    case $source in
        /dev/disk/by-*/*|/dev/mapper/*|/dev/block/*)
            dir=${source%/*}; leaf=${source##*/}
            case $dir in /dev/disk/by-uuid|/dev/disk/by-label|/dev/disk/by-id|/dev/disk/by-path|/dev/disk/by-partuuid|/dev/disk/by-partlabel|/dev/mapper|/dev/block) ;; *) return 1;; esac
            [[ -n $leaf && $leaf != . && $leaf != .. && $leaf != *[[:cntrl:]]* ]] || return 1
            # Only standard local device alias directories; never chase arbitrary links.
            [[ ! -L $devroot && ! -L $devroot/disk && ! -L $devroot/${dir#/dev/} ]] || return 1
            link=$(/usr/bin/readlink -- "$devroot/${source#/dev/}" 2>/dev/null) || return 1
            case $dir:$link in
                /dev/disk/*:../../*) name=${link#../../} ;;
                /dev/mapper:../*|/dev/block:../*) name=${link#../} ;;
                *:/dev/*) name=${link#/dev/} ;;
                *) return 1 ;;
            esac ;;
        /dev/*) name=${source#/dev/} ;;
        *) return 1 ;;
    esac
    [[ $name =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.+-]*$ ]] || return 1
    # A canonical kernel block name is resolved through sysfs, not mount paths.
    [[ ! -L $devroot/$name ]] || return 1
    IFS= read -r obs_mount_source_mm 2>/dev/null < "$blocks/$name/dev" || return 1
    [[ $obs_mount_source_mm =~ ^[0-9]+:[0-9]+$ ]] || return 1
    [[ $source != /dev/block/* || ${source##*/} == "$obs_mount_source_mm" ]]
}
# Inputs are proc/sysfs paths, plus already observed NBD/partition dev_t values.
# This is a bounded, non-atomic self-namespace observation, never detach authorization.
obs_mount_refs() {
    local info=$1 blocks=$2 btrfs=$3 devroot=$4 ids_ok=$5
    shift 5
    local -A wanted=() member_group=() target_group=() group_partial=() source_cache=() seen_mount=()
    local id fs uuid entry mm n=0 entries=0 groups=0 members=0 devinfos=0 sources=0 missing
    local line sep i mid fsmm root target fstype source source_mm group method rec
    local partial=no inventory=not_sampled loaded=no truncated=no count=0
    local obs_mount_source_mm=unknown
    local -a cols=()
    mounts=unknown; mount_state=unknown; mount_coverage=unknown; mount_refs=; mount_count=0
    mount_btrfs_inventory=not_sampled; mount_truncated=no
    for id in "$@"; do [[ $id =~ ^[0-9]+:[0-9]+$ ]] && wanted[$id]=yes; done
    [[ $ids_ok == yes && ${#wanted[@]} -gt 0 ]] || partial=yes
    [[ -r $info ]] || return 0
    mounts=; mount_coverage=complete
    # A readable proc record is evidence only within the reader's root/namespace.
    while :; do
        line=
        if ! IFS= read -r line; then
            if [[ -n $line ]]; then ((n+=1)); partial=yes; fi
            break
        fi
        ((n+=1))
        if (( n > 4096 || ${#line} > 16384 )); then partial=yes; truncated=yes; break; fi
        IFS=' ' read -r -a cols <<< "$line"
        sep=-1
        for ((i=6;i<${#cols[@]};i++)); do
            if [[ ${cols[i]} == - ]]; then sep=$i; break; fi
        done
        if (( sep < 6 || ${#cols[@]} != sep+4 )) ||
           [[ ! ${cols[0]:-} =~ ^[0-9]+$ || ! ${cols[1]:-} =~ ^[0-9]+$ || ! ${cols[2]:-} =~ ^[0-9]+:[0-9]+$ || ${cols[3]:-} != /* || ${cols[4]:-} != /* ]]; then
            partial=yes; continue
        fi
        mid=${cols[0]}; fsmm=${cols[2]}; root=${cols[3]}; target=${cols[4]}
        fstype=${cols[sep+1]}; source=${cols[sep+2]}; method=; source_mm=unknown; group=unknown
        if [[ ${seen_mount[$mid]+x} ]]; then partial=yes; continue; fi
        seen_mount[$mid]=yes
        if [[ ${wanted[$fsmm]+x} ]]; then method=block_dev_t; fi
        if [[ $fstype == btrfs ]]; then
            # Lazy inventory: do not touch Btrfs sysfs unless a visible Btrfs mount exists.
            if [[ $loaded == no ]]; then
                loaded=yes; inventory=complete
                if [[ ! -d $btrfs || ! -r $btrfs || ! -x $btrfs ]]; then inventory=partial
                else
                    for fs in "$btrfs"/*; do
                        uuid=${fs##*/}
                        [[ $uuid =~ ^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$ ]] || continue
                        ((groups+=1)); if ((groups > 64)); then inventory=partial; truncated=yes; break; fi
                        members=0; devinfos=0
                        if [[ ! -d $fs/devices || ! -r $fs/devices || ! -x $fs/devices ]]; then group_partial[$uuid]=yes; inventory=partial; continue; fi
                        for entry in "$fs"/devices/*; do
                            [[ -e $entry || -L $entry ]] || continue
                            ((entries+=1)); if ((entries > 256)); then group_partial[$uuid]=yes; inventory=partial; truncated=yes; break; fi
                            if ! IFS= read -r mm 2>/dev/null < "$entry/dev" || [[ ! $mm =~ ^[0-9]+:[0-9]+$ ]]; then group_partial[$uuid]=yes; continue; fi
                            ((members+=1))
                            if [[ ${member_group[$mm]+x} && ${member_group[$mm]} != "$uuid" ]]; then member_group[$mm]=ambiguous; inventory=partial
                            else member_group[$mm]=$uuid; fi
                            [[ ! ${wanted[$mm]+x} ]] || target_group[$uuid]=yes
                        done
                        if [[ ! -d $fs/devinfo || ! -r $fs/devinfo || ! -x $fs/devinfo ]]; then group_partial[$uuid]=yes
                        else
                            for entry in "$fs"/devinfo/*; do
                                [[ -e $entry || -L $entry ]] || continue
                                ((entries+=1)); if ((entries > 256)); then group_partial[$uuid]=yes; inventory=partial; truncated=yes; break; fi
                                ((devinfos+=1))
                                if ! IFS= read -r missing 2>/dev/null < "$entry/missing" || [[ $missing != 0 ]]; then group_partial[$uuid]=yes; fi
                            done
                        fi
                        if ((members == 0 || members != devinfos)); then group_partial[$uuid]=yes; fi
                        if [[ ${group_partial[$uuid]+x} ]]; then inventory=partial; fi
                        if ((entries > 256)); then break; fi
                    done
                fi
                ((groups > 0)) || inventory=partial
            fi
            if [[ ${source_cache[$source]+x} ]]; then source_mm=${source_cache[$source]}
            else
                ((sources+=1))
                if ((sources > 128)); then partial=yes; truncated=yes
                elif obs_mount_source_id "$source" "$blocks" "$devroot"; then source_mm=$obs_mount_source_mm; fi
                source_cache[$source]=$source_mm
            fi
            group=${member_group[$source_mm]:-unknown}
            if [[ ${wanted[$source_mm]+x} ]]; then method=btrfs_source_dev_t
            elif [[ $group != unknown && $group != ambiguous && ${target_group[$group]+x} ]]; then method=btrfs_member_dev_t; fi
            # Never infer an unrelated Btrfs mount from an unresolvable source.
            if [[ $inventory != complete || $group == unknown || $group == ambiguous || ${group_partial[$group]+x} ]]; then partial=yes; fi
        fi
        [[ -n $method ]] || continue
        ((count+=1))
        rec="$mid"$'\t'"$fsmm"$'\t'"$fstype"$'\t'"$source"$'\t'"$root"$'\t'"$target"$'\t'"$method"$'\t'"$source_mm"$'\t'"$group"
        if (( ${#mount_refs}+${#rec}+1 > 8192 || ${#mounts}+${#target}+${#fsmm}+2 > 4096 )); then partial=yes; truncated=yes; continue; fi
        mounts+="${mounts:+$'\n'}$fsmm:$target"
        mount_refs+="${mount_refs:+$'\n'}$rec"
    done 2>/dev/null < "$info" || partial=yes
    mount_count=$count; mount_btrfs_inventory=$inventory; mount_truncated=$truncated
    if ((n == 0)); then mount_state=unknown; mount_coverage=unknown; mounts=unknown
    else
        [[ $partial == no ]] || mount_coverage=partial
        if ((count > 0)); then mount_state=present; [[ -n $mounts ]] || mounts=present_details_truncated
        elif [[ $partial == yes ]]; then mount_state=partial; mounts=partial
        else mount_state=none_observed; mounts=none_observed; fi
    fi
    return 0
}
# Namespace identity is metadata, not a request to enter another namespace.
obs_mount_namespace() {
    local self=$1 pid1=$2 ns
    mount_namespace=unknown; mount_pid1_relation=unknown
    ns=$(/usr/bin/readlink -- "$self" 2>/dev/null) || return 0
    [[ $ns =~ ^mnt:\[[0-9]+\]$ ]] || return 0
    mount_namespace=$ns
    if [[ -e $self && -e $pid1 ]]; then
        if [[ $self -ef $pid1 ]]; then mount_pid1_relation=same; else mount_pid1_relation=different; fi
    fi
    return 0
}
obs_snapshot() {
    local base="${NBD_MONITOR_SYS_CLASS_BLOCK:-/sys/class/block}/$dev" rc=0 pid size check inflight stat ro queue drv holder entry
    local tcp_rc=unknown tcp_raw= tcp_result=unknown tcp_scope=endpoint_candidates host=${data_host:-unknown}
    local -a fields=() holders=()
    size=$(obs_attr "$base/size"); pid=$(obs_attr "$base/pid")
    inflight=$(obs_attr "$base/inflight"); stat=$(obs_attr "$base/stat")
    ro=$(obs_attr "$base/ro"); queue=$(obs_attr "$base/queue/io_timeout")
    drv=$(obs_attr "${NBD_MONITOR_OBS_DEBUGFS:-/sys/kernel/debug/nbd}/$dev/timeout")
    check=$(timeout --foreground --kill-after=0.1s 0.4s "${NBD_MONITOR_NBD_CLIENT:-/usr/sbin/nbd-client}" -c "/dev/$dev" 2>/dev/null) || rc=$?
    local status=unknown
    if [[ $size =~ ^[0-9]+$ ]]; then
        if [[ $rc == 0 && $size != 0 ]]; then status=connected; elif [[ $rc == 1 && $size == 0 ]]; then status=disconnected; fi
    fi
    local holders_state=unknown mounts=unknown swaps=unknown id partition
    local ids_ok=no mount_state mount_coverage mount_refs mount_count mount_btrfs_inventory mount_truncated mount_namespace mount_pid1_relation
    local -a ids=() nodes=("$base") mount_fields=()
    for partition in "${NBD_MONITOR_SYS_CLASS_BLOCK:-/sys/class/block}/""$dev"p[0-9]*; do [[ -e $partition ]] && nodes+=("$partition"); done
    holders_state=none_observed
    for entry in "${nodes[@]}"; do
        id=$(obs_attr "$entry/dev"); [[ $id =~ ^[0-9]+:[0-9]+$ ]] && ids+=("$id")
        if [[ ! -d $entry/holders || ! -r $entry/holders ]]; then holders_state=unknown; continue; fi
        for holder in "$entry"/holders/*; do [[ -e $holder ]] && holders+=("${entry##*/}:${holder##*/}"); done
    done
    ((${#holders[@]} == 0)) || holders_state=present
    ((${#ids[@]} == ${#nodes[@]})) && ids_ok=yes
    obs_mount_refs /proc/self/mountinfo "${NBD_MONITOR_SYS_CLASS_BLOCK:-/sys/class/block}" /sys/fs/btrfs /dev "$ids_ok" "${ids[@]}"
    obs_mount_namespace /proc/self/ns/mnt /proc/1/ns/mnt
    if [[ $mount_namespace == unknown && $mount_coverage == complete ]]; then
        mount_coverage=partial
        if [[ $mount_state == none_observed ]]; then mount_state=partial; mounts=partial; fi
    fi
    mount_fields=("MOUNTS_SELF_NAMESPACE=$mounts" "MOUNTS_STATE=$mount_state" "MOUNTS_COVERAGE=$mount_coverage" "MOUNTS_SCOPE=self_visible_direct_block_and_btrfs" \
        "MOUNT_NAMESPACE_ID=$mount_namespace" "MOUNT_NAMESPACE_PID1_RELATION=$mount_pid1_relation" "MOUNTS_COUNT=$mount_count" "MOUNTS_REFS=$mount_refs" \
        "MOUNTS_BTRFS_INVENTORY=$mount_btrfs_inventory" "MOUNTS_TRUNCATED=$mount_truncated")
    # /proc/swaps path matching is only an observation in this namespace, not
    # the existing rescue safety check (aliases may not resolve here).
    if [[ -r /proc/swaps ]]; then
        swaps=$(awk -v d="/dev/$dev" 'NR>1 && ($1==d || $1 ~ ("^" d "p[0-9]+$")){print $1}' /proc/swaps) || swaps=unknown
        [[ -n $swaps ]] || swaps=none_observed_by_path
    fi
    # Numeric literal addresses only; no DNS at shutdown. IPv6 support is
    # best-effort using ss's literal address filter (no parsing of its output).
    if [[ $host =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ || ( $host == *:* && $host =~ ^[0-9a-fA-F:]+$ ) ]] && [[ ${data_port:-} =~ ^[0-9]{1,5}$ ]]; then
        tcp_rc=0
        tcp_raw=$(timeout --foreground --kill-after=0.1s 0.6s "${NBD_MONITOR_OBS_SS:-/usr/bin/ss}" -H -ntaoie "( dst $host and dport = :$data_port )" 2>/dev/null) || tcp_rc=$?
        if ((tcp_rc == 0)); then
            if [[ -n $tcp_raw ]]; then tcp_result=candidates_visible; else tcp_result=no_candidates_visible; fi
        else tcp_result=query_failed; fi
    else tcp_result=endpoint_unresolved; fi
    local truncated=no
    if ((${#tcp_raw} > 12000)); then tcp_raw=${tcp_raw:0:12000}; truncated=yes; fi
    local inflight_read=unknown inflight_write=unknown
    if [[ $inflight =~ ^[[:space:]]*([0-9]+)[[:space:]]+([0-9]+)[[:space:]]*$ ]]; then
        inflight_read=${BASH_REMATCH[1]}; inflight_write=${BASH_REMATCH[2]}
    fi
    fields=("DEVICE_STATUS=$status" "DEVICE_SIZE_SECTORS=$size" "DEVICE_PID=$pid" "CHECK_RC=$rc" "CHECK_OUTPUT=$check" \
        "INFLIGHT_RAW=$inflight" "INFLIGHT_READ=$inflight_read" "INFLIGHT_WRITE=$inflight_write" "BLOCK_STAT_RAW=$stat" "DEVICE_RO=$ro" "QUEUE_IO_TIMEOUT_MS=$queue" "DRIVER_TIMEOUT_RAW=$drv" \
        "MAJOR_MINOR=$(obs_attr "$base/dev")" "HOLDERS_STATE=$holders_state" "HOLDERS=${holders[*]}" "${mount_fields[@]}" "SWAPS_PATH_ONLY=$swaps" \
        "TCP_MAPPING=unverified" "TCP_SCOPE=$tcp_scope" "TCP_RESULT=$tcp_result" "TCP_QUERY_RC=$tcp_rc" "TCP_RAW=$tcp_raw" "TCP_TRUNCATED=$truncated")
    local path="$run_dir/observation.latest" field
    [[ $obs_action != baseline ]] || path="$run_dir/observation.baseline"
    # No stale/unknown hook may overwrite the current context's runtime files.
    if [[ $obs_context_ok == yes && $obs_locked == yes ]]; then
        local -a saved_fields=("observation_id=$obs_id" "boot=$boot_id" "session=$session" "stage=$obs_stage")
        for field in "${fields[@]}"; do saved_fields+=("$(obs_escape "$field")"); done
        obs_atomic "$path" "${saved_fields[@]}" || obs_emit "$obs_phase" "$obs_stage" observation_runtime_write_failed "PATH=${path##*/}" || :
    fi
    obs_summary_device=$status; obs_summary_size=$size; obs_summary_check_rc=$rc; obs_summary_tcp=$tcp_result
    if [[ $obs_action == baseline ]]; then
        local pkgver
        pkgver=$(timeout --foreground --kill-after=0.1s 0.3s /usr/bin/dpkg-query -W -f='${Version}' nbd-client 2>/dev/null) || pkgver=unknown
        obs_emit startup run device_connected "CLIENT_PACKAGE_VERSION=$pkgver" "CONNECTION_CONFIRMED_BEFORE_REGISTER=yes" "DEVICE_STATUS_AT_SAMPLE=$status" "DEVICE_SIZE_SECTORS=$size" "DEVICE_PID=$pid" "CHECK_RC=$rc" "DATA_HOST=${data_host:-unknown}" "DATA_PORT=${data_port:-unknown}" "EXPORT=${data_export:-unknown}" "${mount_fields[@]}" || :
    else
        obs_emit "$obs_phase" "$obs_stage" device_tcp_snapshot "${fields[@]}" || :
    fi
}
# Journal cursor is scoped to boot + observation ID. It is not advanced after
# a failed query. Bounded fallback may duplicate old messages; disclose gaps.
obs_kernel() {
    local cursor= prior_id= prior_boot= line key val out rc=0 new_cursor= count=0 relevant=0 raw= gap=no mode=incremental prior_gap=no prior_query=unknown
    local disc=not_observed senderr=not_observed shutdown=not_observed zero=not_observed error_raw= error_codes=
    local journal=${NBD_MONITOR_OBS_JOURNALCTL:-/usr/bin/journalctl} file="$run_dir/kernel.cursor"
    local -a args=(-k -b "${boot_id//-/}" --no-pager --no-hostname -o short-monotonic --show-cursor)
    if [[ $obs_context_ok == yes && -r $file ]]; then
        while IFS= read -r line; do
            key=${line%%=*}; val=${line#*=}
            case $key in id) prior_id=$val;; boot) prior_boot=$val;; cursor) cursor=$val;; query) prior_query=$val;;
                gap) [[ $val == yes ]] && gap=yes;; disconnect) [[ $val == yes ]] && disc=yes;;
                send_error) [[ $val == yes ]] && senderr=yes;; shutdown) [[ $val == yes ]] && shutdown=yes;;
                zero) [[ $val == yes ]] && zero=yes;; esac
        done < "$file"
        if [[ $prior_id != "$obs_id" || $prior_boot != "$boot_id" ]]; then cursor=; gap=no; prior_query=unknown; disc=not_observed; senderr=not_observed; shutdown=not_observed; zero=not_observed; fi
    fi
    prior_gap=$gap
    if [[ $obs_action == init ]]; then
        # Start at latest existing kernel message; baseline is before READY.
        out=$(timeout --foreground --kill-after=0.1s 0.7s "$journal" "${args[@]}" -n 1 2>/dev/null) || rc=$?
        if ((rc == 0)); then
            while IFS= read -r line; do [[ $line == '-- cursor: '* ]] && new_cursor=${line#-- cursor: }; done <<< "$out"
        fi
        [[ -n $new_cursor ]] || gap=yes
    else
        if [[ -n $cursor && $cursor != *[[:space:]]* ]]; then
            out=$(timeout --foreground --kill-after=0.1s 1s "$journal" "${args[@]}" --after-cursor="$cursor" -n +257 2>/dev/null) || rc=$?
        else rc=1; fi
        if ((rc != 0)); then
            mode=bounded_fallback; gap=yes; rc=0
            out=$(timeout --foreground --kill-after=0.1s 0.8s "$journal" "${args[@]}" --since=-120sec -n 257 2>/dev/null) || rc=$?
        fi
        if ((rc == 0)); then
            while IFS= read -r line; do
                if [[ $line == '-- cursor: '* ]]; then new_cursor=${line#-- cursor: }; continue; fi
                [[ $line == '['* ]] || continue
                ((count+=1))
                [[ $line =~ (^|[^[:alnum:]_])${dev}(p[0-9]+)?([^[:alnum:]_]|$) ]] || continue
                ((relevant+=1))
                # Preserve the original monotonic timestamp and text.
                if ((${#raw}+${#line}<24000)); then raw+="$line"$'\n'; else gap=yes; fi
                # A fallback window can overlap a previous incarnation of the
                # same nbdN. Keep the raw candidate, but do not promote it to a
                # confirmed per-session observation or cumulative flag.
                case $line in
                    *NBD_DISCONNECT*) [[ $mode == incremental ]] && disc=yes;;
                    *'Send disconnect failed'*)
                        [[ $mode != incremental ]] || senderr=yes
                        if ((${#error_raw}+${#line}<12000)); then error_raw+="$line"$'\n'; else gap=yes; fi
                        if [[ $line =~ Send\ disconnect\ failed[[:space:]]+(-?[0-9]+) ]]; then error_codes+="${BASH_REMATCH[1]} "; fi
                        ;;
                    *'shutting down sockets'*) [[ $mode != incremental ]] || shutdown=yes;;
                    *'detected capacity change'*' to 0'*) [[ $mode != incremental ]] || zero=yes;;
                esac
            done <<< "$out"
            ((count < 257)) || gap=yes
            # A bounded recent raw batch is useful for an exit trigger missed
            # by the sampler; preserve it in RAM, not in permanent logs.
            if [[ $obs_context_ok == yes && $obs_locked == yes && -n $raw && $obs_phase != exit && $mode == incremental ]]; then
                obs_atomic "$run_dir/kernel.recent" "id=$obs_id" "$raw" || :
            fi
            # Startup/ordinary kernel messages are already in the native
            # journal. Duplicate into structured evidence only for exit or
            # significant runtime errors/transition messages.
            if [[ -n $raw ]]; then
                if [[ $mode == bounded_fallback ]]; then
                    if [[ $obs_phase == exit || $prior_query != fallback ]]; then
                        obs_emit "$obs_phase" "$obs_stage" kernel_candidate_messages "KERNEL_RAW=$raw" "KERNEL_QUERY_MODE=$mode" "KERNEL_ASSOCIATION=unverified_window" "KERNEL_RELEVANT_COUNT=$relevant" || :
                    fi
                elif [[ $obs_phase == exit || $raw =~ (NBD_DISCONNECT|[Ss]end\ disconnect\ failed|[Ss]hutting\ down\ sockets|[Dd]isconnected|[Ee]rror|[Ff]ailed|[Tt]imeout|[Ss]tuck\ request) ]]; then
                    obs_emit "$obs_phase" "$obs_stage" kernel_nbd_messages "KERNEL_RAW=$raw" "KERNEL_QUERY_MODE=$mode" "KERNEL_ASSOCIATION=device_window" "KERNEL_RELEVANT_COUNT=$relevant" || :
                fi
                if [[ -n $error_raw ]]; then
                    if [[ $mode == incremental ]]; then
                        obs_emit "$obs_phase" "$obs_stage" kernel_disconnect_send_failed "KERNEL_RAW=$error_raw" "KERNEL_ERROR_CODES=${error_codes% }" "KERNEL_ASSOCIATION=device_window" || :
                    elif [[ $obs_phase == exit || $prior_query != fallback ]]; then
                        obs_emit "$obs_phase" "$obs_stage" kernel_disconnect_send_failed_candidate "KERNEL_RAW=$error_raw" "KERNEL_ERROR_CODES=${error_codes% }" "KERNEL_ASSOCIATION=unverified_window" || :
                    fi
                fi
            fi
        else gap=yes; fi
        [[ -n $new_cursor ]] || { [[ $mode == incremental && $count == 0 && $rc == 0 ]] && new_cursor=$cursor; }
        [[ -n $new_cursor ]] || gap=yes
    fi
    if [[ $obs_phase == exit && $obs_context_ok == yes && $obs_locked == yes && -r $run_dir/kernel.recent ]]; then
        local recent_id recent_raw
        { IFS= read -r recent_id; recent_raw=$(cat); } < "$run_dir/kernel.recent"
        if [[ $recent_id == "id=$obs_id" && -n $recent_raw ]]; then
            obs_emit exit "$obs_stage" kernel_pre_exit_context "KERNEL_RAW=$recent_raw" "CONTEXT=previous_runtime_batch_may_overlap" || :
        fi
        rm -f -- "$run_dir/kernel.recent" 2>/dev/null || :
    fi
    local query_result=ok
    if ((rc != 0)); then query_result=failed
    elif [[ $mode == bounded_fallback ]]; then query_result=fallback
    elif [[ -z $new_cursor ]]; then query_result=no_cursor
    fi
    if [[ $obs_context_ok == yes && $obs_locked == yes ]]; then
        # On failure retain previous valid cursor; gap remains sticky.
        [[ -n $new_cursor ]] || new_cursor=$cursor
        obs_atomic "$file" "id=$obs_id" "boot=$boot_id" "cursor=$new_cursor" "gap=$gap" "query=$query_result" "disconnect=$disc" "send_error=$senderr" "shutdown=$shutdown" "zero=$zero" || gap=yes
    else gap=yes; fi
    if [[ $gap == yes ]]; then
        [[ $disc == yes ]] || disc=unknown; [[ $senderr == yes ]] || senderr=unknown
        [[ $shutdown == yes ]] || shutdown=unknown; [[ $zero == yes ]] || zero=unknown
    fi
    obs_summary_disc=$disc; obs_summary_senderr=$senderr; obs_summary_shutdown=$shutdown; obs_summary_zero=$zero; obs_summary_gap=$gap
    if [[ $obs_phase == exit || ( $gap == yes && $prior_gap == no ) || ( $prior_query != unknown && $query_result != "$prior_query" ) ]]; then
        obs_emit "$obs_phase" "$obs_stage" kernel_observation_summary "KERNEL_QUERY_RC=$rc" "KERNEL_QUERY_RESULT=$query_result" "KERNEL_QUERY_MODE=$mode" "KERNEL_EVIDENCE_GAP=$gap" "KERNEL_COVERAGE=best_effort" \
            "DISCONNECT_OBSERVED=$disc" "DISCONNECT_SEND_ERROR_OBSERVED=$senderr" "SOCKET_SHUTDOWN_OBSERVED=$shutdown" "CAPACITY_ZERO_OBSERVED=$zero" || :
    fi
}
# Parse only the known, single Debian native ExecStop record. Unknown formats
# remain raw evidence, never success. No observation/session identity required.
obs_parse_native_stop() {
    local raw=$1 rc=$2 hook_id=$3 stop
    local -A props=()
    local cmd_re='^\{ path=/usr/sbin/nbd-client ; argv\[\]=/usr/sbin/nbd-client -d /dev/'"$dev"' ; ignore_errors=(yes|no) ; start_time=\[([^]]+)\] ; stop_time=\[([^]]+)\] ; pid=([0-9]+) ; code=([^ ;]+) ; status=([^ ;]+) \}$'
    local time_re='^[A-Z][a-z]{2} [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}( [^[:cntrl:]]+)?$'
    local status_re='^(0|[1-9][0-9]*)(/[[:alnum:]_+-]+)?$'
    native_executed=unknown; native_result=unknown; native_pid=unknown
    native_code=unknown; native_status=unknown; native_start=unknown; native_end=unknown
    native_query_invocation=unknown; native_reason=query_failed
    ((rc == 0)) || return 0
    native_reason=hook_invocation_invalid
    obs_valid_invocation "$hook_id" || return 0
    native_reason=invalid_properties
    obs_read_fields props ExecStop InvocationID <<< "$raw" || return 0
    native_query_invocation=${props[InvocationID]}
    native_reason=invocation_mismatch
    [[ $native_query_invocation == "$hook_id" ]] || return 0
    native_reason=unrecognized_execstop
    stop=${props[ExecStop]}
    [[ $stop =~ $cmd_re ]] || return 0
    local st=${BASH_REMATCH[2]} en=${BASH_REMATCH[3]} pid=${BASH_REMATCH[4]} code=${BASH_REMATCH[5]} status=${BASH_REMATCH[6]}
    if [[ $st == n/a && $en == n/a && $pid == 0 && $code == '(null)' && ( $status == 0 || $status == 0/0 ) ]]; then
        native_executed=no; native_result=not_executed; native_pid=0
        native_code=$code; native_status=$status; native_start=$st; native_end=$en; native_reason=verified_not_executed
        return 0
    fi
    native_reason=invalid_execution_record
    [[ $st =~ $time_re && $en =~ $time_re && $pid =~ ^[1-9][0-9]*$ && $status =~ $status_re ]] || return 0
    case $code in
        exited) if [[ ${status%%/*} == 0 ]]; then native_result=success; else native_result=failed; fi ;;
        killed|dumped) [[ ${status%%/*} != 0 ]] || return 0; native_result=signaled ;;
        *) return 0 ;;
    esac
    native_executed=yes; native_pid=$pid; native_code=$code; native_status=$status
    native_start=$st; native_end=$en; native_reason=verified_execution
    return 0
}
obs_hook_native_result() {
    local raw rc=0 native_executed native_result native_pid native_code native_status native_start native_end native_query_invocation native_reason
    local handoff=unassociated
    raw=$(timeout --foreground --kill-after=0.1s 0.5s "$systemctl_bin" show -p ExecStop -p InvocationID "nbd@$dev.service" 2>/dev/null) || rc=$?
    obs_parse_native_stop "$raw" "$rc" "${INVOCATION_ID:-unknown}"
    # Native hook is the single writer; never wait on observe.lock. Validate
    # association again just before publishing the strictly scoped sidecar.
    if [[ $obs_context_ok == yes ]] && obs_context_matches && [[ ${obs_ctx[id]} == "$obs_id" && ${obs_ctx[invocation]} == "${INVOCATION_ID:-unknown}" ]]; then
        handoff=write_failed
        if obs_atomic "$run_dir/observation.native" "id=$obs_id" "boot=$boot_id" "session=$session" "invocation=$INVOCATION_ID" \
            "executed=$native_executed" "result=$native_result" "code=$native_code" "status=$native_status" "pid=$native_pid" "reason=$native_reason"; then handoff=written; fi
    fi
    obs_emit exit observe-stop native_stop_observed "NATIVE_STOP_EXECUTED=$native_executed" "NATIVE_STOP_RESULT=$native_result" "NATIVE_STOP_PID=$native_pid" "NATIVE_STOP_CODE=$native_code" "NATIVE_STOP_STATUS=$native_status" "NATIVE_STOP_START=$native_start" "NATIVE_STOP_END=$native_end" "NATIVE_INVOCATION_ID=${INVOCATION_ID:-unknown}" "NATIVE_QUERY_INVOCATION_ID=$native_query_invocation" "NATIVE_FACT_REASON=$native_reason" \
        "NATIVE_SERVICE_RESULT=${SERVICE_RESULT:-unknown}" "NATIVE_MAIN_EXIT_CODE=${EXIT_CODE:-unknown}" \
        "NATIVE_MAIN_EXIT_STATUS=${EXIT_STATUS:-unknown}" "NATIVE_EXECSTOP_QUERY_RC=$rc" "NATIVE_EXECSTOP_RAW=$raw" \
        "CONTEXT_MATCH=$obs_context_ok" "CONTEXT_REASON=${obs_context_reason:-unknown}" "NATIVE_HANDOFF=$handoff" || :
}
obs_read_native_handoff() {
    local -A rec=()
    [[ $obs_context_ok == yes ]] && obs_context_matches && [[ ${obs_ctx[id]} == "$obs_id" ]] || return 1
    obs_valid_invocation "${obs_ctx[invocation]}" || return 1
    obs_read_fields rec id boot session invocation executed result code status pid reason < "$run_dir/observation.native" 2>/dev/null || return 1
    [[ ${rec[id]} == "$obs_id" && ${rec[boot]} == "$boot_id" && ${rec[session]} == "$session" && ${rec[invocation]} == "${obs_ctx[invocation]}" ]] || return 1
    case ${rec[executed]}:${rec[result]} in yes:success|yes:failed|yes:signaled|no:not_executed|unknown:unknown) ;; *) return 1;; esac
    native=${rec[result]}; native_executed=${rec[executed]}; native_code=${rec[code]}; native_status=${rec[status]}; native_pid=${rec[pid]}; native_reason=${rec[reason]}; native_invocation=${rec[invocation]}
}
obs_worker() {
    dev=$1 obs_action=$2 obs_stage=$3 obs_phase=$4
    [[ $dev =~ ^nbd(0|[1-9][0-9]*)$ && $EUID == 0 ]] || return 2
    case $obs_action in init|baseline|snapshot|kernel|hook|bind) ;; *) return 2;; esac
    umask 077
    run_dir=${NBD_MONITOR_RUN_DIR:-/run/nbd-monitor}/$dev
    [[ $run_dir == /* ]] || return 2
    boot_id=unknown; IFS= read -r boot_id < /proc/sys/kernel/random/boot_id || :
    client_id=${NBD_OBS_CLIENT:-unknown}; session=${NBD_OBS_SESSION:-unknown}; obs_id=${NBD_OBS_ID:-unknown}
    data_host=${NBD_OBS_HOST:-unknown}; data_port=${NBD_OBS_PORT:-unknown}; data_export=${NBD_OBS_EXPORT:-unknown}
    systemctl_bin=${NBD_MONITOR_SYSTEMCTL:-/usr/bin/systemctl}
    obs_context_ok=no obs_locked=no
    if [[ $obs_action == hook ]]; then
        obs_hook_context
    elif obs_context_matches && [[ ${obs_ctx[id]} == "$obs_id" ]]; then obs_context_ok=yes; fi
    if [[ $obs_context_ok == yes ]] && exec {obs_fd}> "$run_dir/observe.lock"; then
        if flock -n "$obs_fd"; then obs_locked=yes; fi
    fi
    if [[ $obs_context_ok == yes && $obs_locked != yes ]]; then
        obs_emit "$obs_phase" "$obs_stage" observation_lock_busy || :
    fi
    if [[ $obs_action == bind ]]; then obs_bind_invocation || :; return 0; fi
    if [[ $obs_action == hook ]]; then obs_hook_native_result || :; fi
    if [[ $obs_action == baseline || $obs_action == snapshot || $obs_action == hook ]]; then obs_snapshot || :; fi
    # The pre-READY evidence window is irreversible; capture it first.
    if [[ $obs_action == init ]]; then obs_preconnect || :; fi
    obs_kernel || :
    if [[ $obs_stage == disconnect-final ]]; then
        local native=unknown native_executed=unknown native_code=unknown native_status=unknown native_pid=unknown native_reason=handoff_unavailable native_invocation=unknown
        obs_read_native_handoff || :
        obs_emit exit disconnect-final exit_evidence_summary "NATIVE_STOP_RESULT=$native" "NATIVE_STOP_EXECUTED=$native_executed" "NATIVE_STOP_CODE=$native_code" "NATIVE_STOP_STATUS=$native_status" "NATIVE_STOP_PID=$native_pid" "NATIVE_FACT_REASON=$native_reason" "NATIVE_INVOCATION_ID=$native_invocation" \
            "DEVICE_STATUS=${obs_summary_device:-unknown}" "DEVICE_SIZE_SECTORS=${obs_summary_size:-unknown}" "CHECK_RC=${obs_summary_check_rc:-unknown}" \
            "TCP_MAPPING=unverified" "TCP_RESULT=${obs_summary_tcp:-unknown}" \
            "DISCONNECT_OBSERVED=${obs_summary_disc:-unknown}" "DISCONNECT_SEND_ERROR_OBSERVED=${obs_summary_senderr:-unknown}" \
            "SOCKET_SHUTDOWN_OBSERVED=${obs_summary_shutdown:-unknown}" "CAPACITY_ZERO_OBSERVED=${obs_summary_zero:-unknown}" "KERNEL_EVIDENCE_GAP=${obs_summary_gap:-unknown}" || :
    fi
    return 0
}


# 独立子进程进行一次 TCP 请求；外层 timeout 同时限制 connect 和 read。
wire() {
    local host=$1 port=$2 reply
    shift 2
    [[ -n $host && $host != *'/'* && $host != *$'\n'* && $host != *$'\r'* ]] || return 2
    [[ $port =~ ^[1-9][0-9]{0,4}$ ]] || return 2
    exec 3<>"/dev/tcp/$host/$port" || return 1
    printf '%s\n' "$@" END >&3 || return 1
    IFS= read -r -t 2 reply <&3 || return 1
    exec 3>&-
    [[ $reply =~ ^result=(none|ok|wait|error|complete|incomplete|abnormal|ended)$ ]] || return 1
    printf '%s\n' "$reply"
}

if [[ ${1:-} == _wire ]]; then
    (($# >= 4)) || exit 2
    shift
    wire "$@"
    exit $?
fi

request() {
    timeout --signal=TERM --kill-after=1s "${request_timeout_sec}s" \
        "$0" _wire "$control_host" "$control_port" "$@"
}

# 用 nbd-client -c 的退出码 + sysfs 扇区数联合观测。
# 回显 connected/disconnected/unknown；unknown 绝不升格为 zero=yes。
device_status() {
    local rc sectors
    if "$nbd_client" -c "/dev/$dev" >/dev/null 2>&1; then
        rc=0
    else
        rc=$?
    fi
    if [[ ! -r $sys_class_block/$dev/size ]]; then
        printf 'unknown\n'; return
    fi
    IFS= read -r sectors < "$sys_class_block/$dev/size" || sectors=
    if [[ ! $sectors =~ ^[0-9]+$ ]]; then
        printf 'unknown\n'; return
    fi
    if (( rc == 0 && sectors > 0 )); then
        printf 'connected\n'
    elif (( rc == 1 && sectors == 0 )); then
        printf 'disconnected\n'
    else
        printf 'unknown\n'
    fi
}

# 状态只接受已知键；禁止通过 source/eval 执行文件内容。
load_state() {
    declare -gA saved=()
    local line key value
    [[ -f $state_file ]] || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == *=* ]] || die '本地状态格式损坏'
        key=${line%%=*}
        value=${line#*=}
        case $key in client|host|port|export|session|boot|phase) ;; *) die "本地状态含未知键：$key" ;; esac
        [[ ! ${saved[$key]+present} ]] || die "本地状态重复键：$key"
        saved[$key]=$value
    done < "$state_file"
    for key in client host port export session boot phase; do
        [[ ${saved[$key]+present} ]] || die "本地状态缺少键：$key"
    done
    [[ ${saved[phase]} == running || ${saved[phase]} == closed ]] || die '本地状态阶段未知'
    [[ ${saved[session]} =~ ^[0-9a-fA-F-]{36}$ ]] || die '本地 session 无效'
}

save_state() {
    local phase=$1 tmp="$state_file.tmp.$$"
    printf '%s\n' \
        "client=$client_id" "host=$data_host" "port=$data_port" \
        "export=$data_export" "session=$session" "boot=$boot_id" \
        "phase=$phase" > "$tmp"
    mv -f -- "$tmp" "$state_file"
}

# 监护事实与会话状态分别保存，避免心跳的短更新覆盖 disconnect 的 phase=closed。
# health.state 带 session：同一设备新轮不会继承旧轮的异常。
load_health() {
    local line key value
    channel=unknown
    heartbeat_last=none
    sticky_fault=unknown
    close_result=unknown
    detach_result=unknown
    detach_count=0
    [[ -f $health_file ]] || return 0
    declare -A observed=()
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == *=* ]] || die '监护状态格式损坏'
        key=${line%%=*}; value=${line#*=}
        case $key in session|channel|heartbeat_last|fault|close_result|detach_result|detach_count) ;; *) die "监护状态含未知键：$key" ;; esac
        [[ ! ${observed[$key]+present} ]] || die "监护状态重复键：$key"
        observed[$key]=$value
    done < "$health_file"
    # 旧轮或缺少关联标识的附属文件不能影响当前 session。
    [[ ${observed[session]-} == "$session" ]] || return 0
    channel=${observed[channel]-unknown}
    heartbeat_last=${observed[heartbeat_last]-none}
    sticky_fault=${observed[fault]-none}
    close_result=${observed[close_result]-none}
    detach_result=${observed[detach_result]-none}
    detach_count=${observed[detach_count]-0}
    case $channel in unknown|online|unreachable) ;; *) die '监护 channel 状态损坏' ;; esac
    case $heartbeat_last in none|ok|abnormal|ended|error|unexpected|unavailable) ;; *) die '监护 heartbeat_last 状态损坏' ;; esac
    case $sticky_fault in unknown|none|heartbeat_abnormal|server_ended_while_connected|heartbeat_error|heartbeat_unexpected|server_close_abnormal|detach_recovered|detach_blocked|detach_failed) ;; *) die '监护 fault 状态损坏' ;; esac
    case $close_result in unknown|none|complete|abnormal) ;; *) die '监护 close_result 状态损坏' ;; esac
    case $detach_result in unknown|none|disabled|blocked|recovered|failed) ;; *) die '监护 detach_result 状态损坏' ;; esac
    [[ $detach_count =~ ^[0-9]+$ ]] || die '监护 detach_count 状态损坏'
}

save_health() {
    local tmp="$health_file.tmp.$$"
    printf '%s\n' \
        "session=$session" "channel=$channel" "heartbeat_last=$heartbeat_last" \
        "fault=$sticky_fault" "close_result=$close_result" \
        "detach_result=$detach_result" "detach_count=$detach_count" > "$tmp"
    mv -f -- "$tmp" "$health_file"
}

# 心跳更新只在本轮仍为 running 时落地；避免与 ExecStop 的收尾覆盖竞态。
commit_health_if_running() {
    local fd observed_channel=$channel observed_last=$heartbeat_last observed_fault=$sticky_fault
    exec {fd}> "$run_dir/run.lock" || return 1
    if ! flock -w 1 "$fd"; then
        exec {fd}>&-
        return 1
    fi
    if load_state && [[ ${saved[session]} == "$session" && ${saved[phase]} == running ]]; then
        # disconnect 也写 health.state：读取最新值再合并，避免 20 秒的补做流程
        # 结束后被延迟的 heartbeat 覆盖 detach_result / detach_count / fault。
        load_health
        channel=$observed_channel
        heartbeat_last=$observed_last
        if [[ $sticky_fault == none || $sticky_fault == unknown ]]; then
            sticky_fault=$observed_fault
        fi
        save_health
    fi
    exec {fd}>&-
}

# 支持简单 INI，既不 shell source，也不允许未识别键静默生效。
parse_config() {
    local line section= key value scope seenkey
    declare -gA cfg=() seen=()
    [[ -r $config_file ]] || die "无法读取 $config_file"
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line != *$'\r'* ]] || die '配置文件不得使用 CRLF'
        line=${line#"${line%%[!$' \t']*}"}
        line=${line%"${line##*[!$' \t']}"}
        [[ -n $line && $line != \#* ]] || continue
        if [[ $line == \[*\] ]]; then
            section=${line:1:${#line}-2}
            [[ $section == global || $section =~ ^nbd[0-9]+$ ]] || die "配置段无效：$section"
            [[ ! ${seen["section|$section"]+present} ]] || die "重复配置段：$section"
            seen["section|$section"]=yes
            continue
        fi
        [[ -n $section && $line == *=* ]] || die "配置行无效：$line"
        key=${line%%=*}; value=${line#*=}
        key=${key#"${key%%[!$' \t']*}"}; key=${key%"${key##*[!$' \t']}"}
        value=${value#"${value%%[!$' \t']*}"}; value=${value%"${value##*[!$' \t']}"}
        case $key in
            client_id|control_port|control_host|heartbeat_interval_sec|request_timeout_sec|startup_report_timeout_sec|detach_attempts|detach_interval_sec|detach_enabled) ;;
            *) die "未知配置项：$key" ;;
        esac
        if [[ $section != global && $key != control_host && $key != control_port ]]; then
            die "设备段只支持 control_host/control_port：$key"
        fi
        seenkey="$section|$key"
        [[ ! ${seen[$seenkey]+present} ]] || die "重复配置项：$seenkey"
        seen[$seenkey]=yes
        cfg[$seenkey]=$value
    done < "$config_file"
}

parse_nbdtab() {
    local line part item opt option seen_count=0
    local -a fields=() options=()
    [[ -r $nbdtab ]] || die "无法读取 $nbdtab"
    data_host= data_port=10809 data_export=
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%\#*}
        read -r -a fields <<< "$line"
        ((${#fields[@]} > 0)) || continue
        [[ ${fields[0]} == "$dev" ]] || continue
        ((seen_count+=1))
        ((${#fields[@]} == 3 || ${#fields[@]} == 4)) || die 'nbdtab 目标行字段数不符'
        data_host=${fields[1]}
        data_export=${fields[2]}
        [[ $data_export != '""' && $data_export != "''" ]] || die '当前版本不支持 nbdtab 空导出名'
        if ((${#fields[@]} == 4)); then
            IFS=, read -r -a options <<< "${fields[3]}"
            for opt in "${options[@]}"; do
                case $opt in
                    port=*) data_port=${opt#port=} ;;
                    persist|swap|unix|conns=*|_*) die "当前阶段不支持 nbdtab 选项：$opt" ;;
                    *) ;; # 原生 nbd-client 自行解释其它参数
                esac
            done
        fi
    done < "$nbdtab"
    (( seen_count == 1 )) || die "nbdtab 中 $dev 条目数为 $seen_count（必须恰好一条）"
    [[ $data_port =~ ^[1-9][0-9]{0,4}$ ]] || die '数据端口不是规范整数'
    ((10#$data_port <= 65535)) || die '数据端口超范围'
    [[ $data_host != *'/'* && -n $data_host && $data_host != *$'\r'* ]] || die '数据主机地址无效'
}

# 仅当原生 nbd@ 已停止以后，才允许有限补做 detach。
# 连接 PID 是防止旧轮误操作新轮的附加保护，而非内核级原子锁。
check_connection_identity() {
    local x name value recorded_session= recorded_pid= live
    [[ -r $connection_file ]] || { log '无连接身份快照'; return 1; }
    while IFS= read -r x || [[ -n $x ]]; do
        name=${x%%=*}; value=${x#*=}
        case $name in
            session) recorded_session=$value ;;
            pid) recorded_pid=$value ;;
            *) return 1 ;;
        esac
    done < "$connection_file"
    [[ $recorded_session == "$session" && $recorded_pid =~ ^[1-9][0-9]*$ ]] || return 1
    live=$($nbd_client -c "/dev/$dev" 2>/dev/null) || return 1
    [[ $live == "$recorded_pid" ]]
}

# 动态筛查：本 mount namespace 的 block major:minor、swap、以及 sysfs holders。
# 该检查不是对全部进程/namespace I/O 的原子证明；无法观测时一律拒绝补做。
check_detach_safety() {
    local entry id holder src rest canonical
    local -a block_entries=("$sys_class_block/$dev")
    local -a major_minor=()
    for entry in "$sys_class_block"/"$dev"p[0-9]*; do
        [[ -e $entry ]] && block_entries+=("$entry")
    done
    [[ -r /proc/self/mountinfo && -r /proc/swaps ]] || { log '无法读取挂载/swap 状态'; return 1; }
    for entry in "${block_entries[@]}"; do
        [[ -r $entry/dev && -d $entry/holders ]] || { log "缺失 sysfs 使用信息：$entry"; return 1; }
        IFS= read -r id < "$entry/dev" || return 1
        [[ $id =~ ^[0-9]+:[0-9]+$ ]] || return 1
        major_minor+=("$id")
        for holder in "$entry"/holders/*; do
            [[ -e $holder ]] || continue
            log "块设备有上层 holder：$holder"
            return 1
        done
    done
    for id in "${major_minor[@]}"; do
        if awk -v dev_id="$id" '$3 == dev_id { found=1; exit } END { exit !found }' /proc/self/mountinfo; then
            log "设备或分区仍被挂载（major:minor=$id）"
            return 1
        fi
    done
    # swap 设备支持 /dev 下的别名，经过 readlink -f 后匹配设备本体或分区。
    while read -r src rest; do
        [[ $src == Filename ]] && continue
        canonical=$(readlink -f -- "$src" 2>/dev/null) || { log "无法识别 swap 来源：$src"; return 1; }
        if [[ $canonical == "/dev/$dev" || $canonical =~ ^/dev/${dev}p[0-9]+$ ]]; then
            log "设备正在被 swap 使用：$src"
            return 1
        fi
    done < /proc/swaps
    return 0
}

# 此函数必须在 run.lock 被持有、原生 nbd@ 已停止的条件下执行。
# 三次上限 / 30 秒总预算，单次命令另有限时；超时即停止，避免重叠调用。
rescue_detach() {
    local start=$1 attempt rc last_start remaining
    if [[ $detach_enabled != yes ]]; then
        detach_result=disabled
        obs_emit exit disconnect rescue_skipped "REASON=disabled" || :
        log '补做 detach 未显式启用；保留连接'
        save_health
        return 1
    fi
    if ! check_connection_identity || ! check_detach_safety; then
        detach_result=blocked
        [[ $sticky_fault != none ]] || sticky_fault=detach_blocked
        save_health
        obs_emit exit disconnect rescue_blocked "REASON=identity_or_upper_layer_check_failed" || :
        log '补做前身份或上层占用检查失败；拒绝执行 detach'
        return 1
    fi
    for ((attempt=1; attempt<=detach_attempts; attempt++)); do
        remaining=$(( 30 - (SECONDS - start) ))
        ((remaining >= 5)) || break
        if ! check_connection_identity || ! check_detach_safety; then
            detach_result=blocked
            [[ $sticky_fault != none ]] || sticky_fault=detach_blocked
            save_health
            obs_emit exit disconnect rescue_blocked "REASON=identity_or_upper_layer_check_failed" "ATTEMPT=$attempt" || :
            return 1
        fi
        last_start=$SECONDS
        detach_count=$attempt
        log "补做 detach：第 $attempt/$detach_attempts 次（最多 30 秒）"
        rc=0
        obs_detach_started=${EPOCHREALTIME:-unknown}
        obs_emit exit disconnect rescue_attempt_started "ATTEMPT=$attempt" "DEVICE_BEFORE=not_confirmed_disconnected" || :
        timeout --signal=TERM --kill-after=1s 3s "$nbd_client" -d "/dev/$dev" || rc=$?
        save_health
        obs_emit exit disconnect rescue_attempt_returned "ATTEMPT=$attempt" "DETACH_RC=$rc" "START_EPOCH=$obs_detach_started" || :
        if ((rc == 124 || rc == 137)); then
            detach_result=failed
            [[ $sticky_fault != none ]] || sticky_fault=detach_failed
            save_health
            log "detach 命令超时/被强制结束 rc=$rc；不再尝试，避免与残余任务重叠"
            return 1
        fi
        obs_rescue_device=$(device_status)
        obs_emit exit disconnect rescue_attempt_device "ATTEMPT=$attempt" "DEVICE_AFTER=$obs_rescue_device" || :
        if [[ $obs_rescue_device == disconnected ]]; then
            detach_result=recovered
            [[ $sticky_fault != none ]] || sticky_fault=detach_recovered
            save_health
            log "补做 detach 后设备归零，命令退出码=$rc"
            return 0
        fi
        log "补做后设备仍未确认归零，命令退出码=$rc"
        ((attempt < detach_attempts)) || break
        remaining=$(( 30 - (SECONDS - start) ))
        ((remaining > detach_interval_sec + 2)) || break
        # 周期以本次尝试起始时间为准，而不是在命令结束后再睡满间隔。
        delay=$((detach_interval_sec - (SECONDS - last_start)))
        ((delay > 0)) && sleep "$delay"
    done
    detach_result=failed
    [[ $sticky_fault != none ]] || sticky_fault=detach_failed
    save_health
    obs_emit exit disconnect rescue_exhausted "ATTEMPTS=$detach_count" || :
    log '规定的补做次数/时间窗口耗尽，设备仍未确认归零'
    return 1
}

# P1 hook is deliberately dispatched before config/session loading and business locks.
if [[ ${1:-} == _observe ]]; then
    (($# == 5)) || exit 2
    obs_worker "$2" "$3" "$4" "$5"
    exit $?
fi
if [[ ${1:-} == observe-stop ]]; then
    (($# == 2)) && [[ $2 =~ ^nbd(0|[1-9][0-9]*)$ && $EUID == 0 ]] || exit 2
    dev=$2; boot_id=unknown; IFS= read -r boot_id < /proc/sys/kernel/random/boot_id || :
    run_dir=${NBD_MONITOR_RUN_DIR:-/run/nbd-monitor}/$dev
    [[ $run_dir == /* ]] || exit 0
    obs_hook_context
    obs_call 4.5s hook observe-stop exit || :
    exit 0
fi

usage() {
    printf '%s\n' '用法：nbd-monitor run|disconnect|report|observe-stop nbdN' >&2
    exit 2
}

(($# == 2)) || usage
mode=$1 dev=$2
case $mode in run|disconnect|report) ;; *) usage ;; esac
[[ $dev =~ ^nbd(0|[1-9][0-9]*)$ ]] || die "设备实例名无效：$dev"
(( EUID == 0 )) || die '需要 root 身份'

# Observation-only bookkeeping; does not write business state.
obs_id=unknown; obs_invocation=unknown; failure_reason=none
obs_exit_started=no; obs_disconnect_entered=no; obs_close_attempts=0; obs_close_waits=0; obs_close_no_reply=0
obs_close_outcome=not_attempted; obs_close_last=none; obs_rescue=not_evaluated
obs_close_started_at=unknown
obs_final() {
    local rc=$1
    trap - EXIT
    if [[ $mode == disconnect ]]; then
        # A failed close may leave an old valid session intact, as before.
        # Never infer close success from the process exit status.
        obs_emit exit disconnect monitor_disconnect_finished "MONITOR_RC=$rc" "REASON=$failure_reason" \
            "DISCONNECT_ENTERED=$obs_disconnect_entered" "CLOSE_OUTCOME=$obs_close_outcome" "CLOSE_LAST_REPLY=$obs_close_last" \
            "CLOSE_ATTEMPTS=$obs_close_attempts" "CLOSE_WAITS=$obs_close_waits" "CLOSE_NO_REPLY=$obs_close_no_reply" \
            "CLOSE_STARTED_EPOCH=$obs_close_started_at" "RESCUE_OUTCOME=$obs_rescue" \
            "DETACH_RESULT=${detach_result:-unknown}" "DETACH_COUNT=${detach_count:-0}" || :
        if [[ $obs_disconnect_entered == yes ]]; then obs_call 1.8s snapshot disconnect-final exit || :; fi
    elif [[ $mode == run && $rc != 0 ]]; then
        obs_emit runtime run monitor_run_failed "MONITOR_RC=$rc" "REASON=$failure_reason" || :
    fi
    exit "$rc"
}
if [[ $mode == run || $mode == disconnect ]]; then trap 'obs_final "$?"' EXIT; fi

config_file=${NBD_MONITOR_CONFIG:-/etc/nbd-monitor.conf}
nbdtab=${NBD_MONITOR_NBDTAB:-/etc/nbdtab}
base_run_dir=${NBD_MONITOR_RUN_DIR:-/run/nbd-monitor}
nbd_client=${NBD_MONITOR_NBD_CLIENT:-/usr/sbin/nbd-client}
sys_class_block=${NBD_MONITOR_SYS_CLASS_BLOCK:-/sys/class/block}
systemctl_bin=${NBD_MONITOR_SYSTEMCTL:-/usr/bin/systemctl}
[[ $base_run_dir == /* ]] || die '运行目录必须为绝对路径'
[[ -e $sys_class_block/$dev/size ]] || die "设备 $dev 没有 sysfs size"

parse_config
parse_nbdtab

client_id=${cfg['global|client_id']-}
[[ $client_id =~ ^[a-zA-Z0-9_.-]{1,128}$ ]] || die 'client_id 只能是 1-128 位字母数字及 _.-'
control_host=${cfg["$dev|control_host"]-${cfg['global|control_host']-$data_host}}
control_port=${cfg["$dev|control_port"]-${cfg['global|control_port']-10921}}
heartbeat_interval_sec=${cfg['global|heartbeat_interval_sec']-10}
request_timeout_sec=${cfg['global|request_timeout_sec']-2}
startup_report_timeout_sec=${cfg['global|startup_report_timeout_sec']-5}
detach_attempts=${cfg['global|detach_attempts']-3}
detach_interval_sec=${cfg['global|detach_interval_sec']-10}
detach_enabled=${cfg['global|detach_enabled']-no}
[[ $detach_enabled == no || $detach_enabled == yes ]] || die 'detach_enabled 必须为 yes/no'
for value in "$heartbeat_interval_sec" "$request_timeout_sec" "$startup_report_timeout_sec" "$detach_attempts" "$detach_interval_sec"; do
    [[ $value =~ ^[1-9][0-9]{0,2}$ ]] || die '时间/次数配置需为 1-999 正整数'
done
((request_timeout_sec <= 5 && heartbeat_interval_sec >= 1)) || die '控制请求预算必须 <= 5 秒'
(( detach_attempts <= 3 )) || die '目前最多允许 3 次补做 detach'
(( detach_interval_sec >= 5 )) || die '补做间隔必须 >= 5 秒'
[[ $control_port =~ ^[1-9][0-9]{0,4}$ ]] || die '控制端口无效'
((10#$control_port <= 65535)) || die '控制端口超范围'
[[ -n $control_host && $control_host != *'/'* && $control_host != *$'\r'* ]] || die '控制主机无效'

install -d -o root -g root -m 0700 "$base_run_dir/$dev"
run_dir=$base_run_dir/$dev
state_file=$run_dir/session.state
health_file=$run_dir/health.state
connection_file=$run_dir/connection.state
IFS= read -r boot_id < /proc/sys/kernel/random/boot_id

if [[ $mode == report ]]; then
    printf 'device=%s\n' "$dev"
    printf 'device_status=%s\n' "$(device_status)"
    if load_state; then
        for key in client host port export session boot phase; do
            printf '%s=%s\n' "$key" "${saved[$key]}"
        done
        session=${saved[session]}
        load_health
        printf 'channel=%s\nheartbeat_last=%s\nfault=%s\nclose_result=%s\ndetach_result=%s\ndetach_count=%s\n' \
            "$channel" "$heartbeat_last" "$sticky_fault" "$close_result" "$detach_result" "$detach_count"
    else
        printf 'session=none\n'
    fi
    if [[ -n ${session:-} ]] && obs_context_matches; then
        printf 'observation_id=%s\n' "${obs_ctx[id]}"
        for obs_file in observation.baseline observation.latest kernel.cursor; do
            if [[ -r $run_dir/$obs_file ]] && grep -Fxq "observation_id=${obs_ctx[id]}" "$run_dir/$obs_file"; then
                printf 'observation_file=%s\n' "$run_dir/$obs_file"
            elif [[ $obs_file == kernel.cursor && -r $run_dir/$obs_file ]] && grep -Fxq "id=${obs_ctx[id]}" "$run_dir/$obs_file"; then
                printf 'observation_file=%s\n' "$run_dir/$obs_file"
            fi
        done
    fi
    exit 0
fi

# agent.lock 由 run 长期持有，排除重复的 monitor 守护进程。
# run.lock 只保护会话建立/交接阶段，不能在心跳期间占住，否则 ExecStop 会与 run 自锁。
if [[ $mode == run ]]; then
    exec {agent_fd}> "$run_dir/agent.lock"
    flock -n "$agent_fd" || die '本设备已有 monitor run 在运行'
fi
exec {run_fd}> "$run_dir/run.lock"
if [[ $mode == disconnect ]]; then
    flock -w 5 "$run_fd" || die '会话建立尚未结束或资源锁忙'
else
    flock -n "$run_fd" || die 'run/disconnect 正在操作本地会话'
fi

if [[ $mode == run ]]; then
    recovered=no
    if load_state; then
        if [[ ${saved[phase]} == running ]]; then
            [[ ${saved[boot]} == "$boot_id" && ${saved[client]} == "$client_id" && \
               ${saved[host]} == "$data_host" && ${saved[port]} == "$data_port" && \
               ${saved[export]} == "$data_export" ]] || die '未结束 session 的资源身份发生变化，拒绝继续'
            [[ $(device_status) == connected ]] || die '旧 session 未收尾且当前设备未证实仍连接，请先检查/收尾'
            session=${saved[session]}
            load_health
            recovered=yes
            log "恢复未结束 session=$session；不生成新 session"
        fi
    fi

    if [[ $recovered == no ]]; then
        # 在原始 NBD 连接之前进行 previous；请求失败要记录未知，而不是假装 none。
        start=$SECONDS
        got_previous=no
        while (( SECONDS - start < startup_report_timeout_sec )); do
            if reply=$(request \
                'op=previous' "client=$client_id" "host=$data_host" \
                "port=$data_port" "export=$data_export"); then
                case $reply in result=none|result=complete) ;; *) log "previous: $reply" ;; esac
                got_previous=yes
                break
            fi
            sleep 1
        done
        [[ $got_previous == yes ]] || log 'previous 无有效回复：上轮结果未知（不等于 none）'

    fi

    # Create a new observation identity before native start, even if no session
    # ever gets registered. Recovered sessions reuse matching observation data.
    if [[ $recovered == yes ]] && obs_context_matches; then
        obs_id=${obs_ctx[id]}
        obs_invocation=${obs_ctx[invocation]}
    else
        obs_id=$(obs_uuid) || obs_id=unknown
        obs_invocation=unknown
        if obs_write_context; then
            if [[ $recovered == no ]]; then obs_call 1.2s init run startup || :; fi
        else obs_emit startup run observation_runtime_write_failed "PATH=observation.state" || :; fi
    fi

    # 两条路径都要求在真实连接之前报告 READY（如果由 Type=notify 启动）。
    if [[ -n ${NOTIFY_SOCKET:-} ]]; then
        /usr/bin/systemd-notify --ready --pid=parent --status="启动准备完成，等待 /dev/$dev 连接" \
            || die '无法向 systemd 报告启动就绪'
    fi
    if [[ $recovered == no ]]; then
        start=$SECONDS
        while [[ $(device_status) != connected ]]; do
            (( SECONDS - start < 60 )) || die '等待 NBD 连接超时'
            sleep 1
        done
        IFS= read -r session < /proc/sys/kernel/random/uuid
        save_state running
        channel=unknown
        heartbeat_last=none
        sticky_fault=none
        close_result=none
        detach_result=none
        detach_count=0
        save_health
        # 新一轮连接的 PID 与 session 关联。缺失 PID 只禁止补做，不妨碍继续监护。
        current_pid=$($nbd_client -c "/dev/$dev" 2>/dev/null || :)
        [[ $current_pid =~ ^[1-9][0-9]*$ ]] || current_pid=unknown
        printf 'session=%s\npid=%s\n' "$session" "$current_pid" > "$connection_file.tmp.$$"
        mv -f -- "$connection_file.tmp.$$" "$connection_file"
        [[ $current_pid != unknown ]] || log '无法读取可靠连接 PID；本轮禁止自动补做 detach'
        # Bind only after registration, using independently checked evidence.
        obs_write_context || obs_emit startup run observation_runtime_write_failed "PATH=observation.state" || :
        obs_emit startup run session_created "DATA_HOST=$data_host" "DATA_PORT=$data_port" "EXPORT=$data_export" \
            "NATIVE_INVOCATION_ID=$obs_invocation" "KERNEL_VERSION=$(uname -r)" "MONITOR_VERSION=v0.4.2-P1-R-B" || :
        : # baseline captured immediately after register
    fi

    if [[ $recovered == yes ]]; then
        # Never replace a recovered binding with unknown or another invocation.
        obs_emit startup run session_recovered "NATIVE_INVOCATION_ID=$obs_invocation" || :
    fi
    start=$SECONDS
    registered=no
    while (( SECONDS - start < 30 )); do
        if reply=$(request \
            'op=register' "client=$client_id" "host=$data_host" \
            "port=$data_port" "export=$data_export" "session=$session"); then
            if [[ $reply == result=ok ]]; then
                obs_emit startup run registered "RESULT=ok" || :
                registered=yes
                break
            fi
            [[ $reply == result=wait ]] || log "register: $reply"
            [[ $reply != result=error ]] || die 'register 被服务端拒绝；保留 session 供诊断'
        else
            : # transient registration attempts stay out of permanent logs
        fi
        sleep 1
    done
    [[ $registered == yes ]] || die 'register 超时；保留 session 供诊断'

    # 关键：放开会话状态锁，让 systemd 的 ExecStop=disconnect 能与 run 同时存在。
    flock -u "$run_fd"
    exec {run_fd}>&-
    count=0
    detached=no
    if [[ $recovered == no ]]; then obs_call 2s baseline run startup || :; fi
    obs_call 2.2s bind run startup || :
    obs_last_device=connected
    obs_last_heartbeat=none
    obs_last_channel=unknown
    while :; do
        if load_state && [[ ${saved[phase]} == closed ]]; then
            log '本轮已由 disconnect 收尾，monitor 结束'
            exit 0
        fi
        observed_device=$(device_status)
        obs_snapshot_needed=no
        if [[ $observed_device != "$obs_last_device" ]]; then
            obs_emit runtime run device_state_changed "BEFORE=$obs_last_device" "AFTER=$observed_device" || :
            obs_last_device=$observed_device
            obs_snapshot_needed=yes
        fi
        case $observed_device in
            disconnected)
                if [[ $detached == no ]]; then
                    log '本地设备已解除；暂停心跳，等待原生 nbd@ 停止作业完成及 ExecStop=disconnect'
                    detached=yes
                fi
                ;;
            connected)
                [[ $detached == no ]] || die '设备在本轮断开后又连接，拒绝以旧 session 监控新连接'
                ;;
            unknown) : ;; # state changes above; never declare disconnected
        esac
        if [[ $detached == no ]] && (( count % heartbeat_interval_sec == 0 )); then
            if reply=$(request 'op=heartbeat' "session=$session"); then
                channel=online
                case $reply in
                    result=ok)
                        heartbeat_last=ok
                        ;;
                    result=abnormal)
                        heartbeat_last=abnormal
                        [[ $sticky_fault != none && $sticky_fault != unknown ]] || sticky_fault=heartbeat_abnormal
                        ;;
                    result=ended)
                        heartbeat_last=ended
                        [[ $sticky_fault != none && $sticky_fault != unknown ]] || sticky_fault=server_ended_while_connected
                        ;;
                    result=error)
                        heartbeat_last=error
                        [[ $sticky_fault != none && $sticky_fault != unknown ]] || sticky_fault=heartbeat_error
                        ;;
                    *)
                        heartbeat_last=unexpected
                        [[ $sticky_fault != none && $sticky_fault != unknown ]] || sticky_fault=heartbeat_unexpected
                        ;;
                esac
            else
                channel=unreachable
                heartbeat_last=unavailable
            fi
            if [[ $heartbeat_last != "$obs_last_heartbeat" || $channel != "$obs_last_channel" ]]; then
                obs_emit runtime run heartbeat_changed "BEFORE=$obs_last_heartbeat" "AFTER=$heartbeat_last" "CHANNEL_BEFORE=$obs_last_channel" "CHANNEL_AFTER=$channel" || :
                obs_last_heartbeat=$heartbeat_last; obs_last_channel=$channel
            fi
            # 未能拿锁只意味着 disconnect 可能正在进行；不能让旧心跳覆盖已关闭的轮次。
            if ! commit_health_if_running; then
                log '心跳观测写入未取得短锁，保留旧记录供检查'
            fi
        fi
        # Poll stop state only as an observation trigger. Existing heartbeat
        # and device logic above retains priority and all original conditions.
        if [[ $obs_exit_started == no ]] && (( count % 2 == 0 )); then
            obs_native_state=$(timeout --foreground --kill-after=0.1s 0.4s "$systemctl_bin" show --value -p ActiveState "nbd@$dev.service" 2>/dev/null) || obs_native_state=unknown
            if [[ $obs_native_state == deactivating ]]; then
                obs_exit_started=yes; obs_snapshot_needed=yes
                obs_emit exit run native_stop_seen "ACTIVE_STATE=$obs_native_state" || :
            fi
        fi
        if [[ $observed_device == disconnected ]]; then obs_exit_started=yes; fi
        if [[ $obs_snapshot_needed == yes ]]; then
            obs_phase=runtime; [[ $obs_exit_started != yes ]] || obs_phase=exit
            obs_call 2s snapshot run "$obs_phase" || :
        elif (( count % heartbeat_interval_sec == 0 )); then
            obs_phase=runtime; [[ $obs_exit_started != yes ]] || obs_phase=exit
            obs_call 1.5s kernel run "$obs_phase" || :
        fi
        # Retry only recoverable unknown bindings, after ordinary business.
        if [[ $obs_exit_started == no && $observed_device == connected ]] && (( count > 0 && count % 30 == 0 )); then
            if obs_context_matches && [[ ${obs_ctx[id]} == "$obs_id" && ${obs_ctx[invocation]} == unknown ]] && obs_binding_retryable; then
                obs_call 2.2s bind run runtime || :
            fi
        fi
        sleep 1
        ((count+=1))
    done
fi

# 原生 nbd@ 停止后，仅按原有策略有限补做；确认设备归零才发送 close。
load_state || die '没有可供交接的 session 状态'
[[ ${saved[boot]} == "$boot_id" && ${saved[client]} == "$client_id" && \
   ${saved[host]} == "$data_host" && ${saved[port]} == "$data_port" && \
   ${saved[export]} == "$data_export" ]] || die '状态与当前配置不匹配'
session=${saved[session]}
if obs_context_matches; then obs_id=${obs_ctx[id]}; fi
load_health
if [[ ${saved[phase]} == closed ]]; then
    log "session=$session 本地已标记 closed；不执行第二次收尾"
    exit 0
fi
active_state=$($systemctl_bin show --value -p ActiveState "nbd@$dev.service") || die '无法检查原生 NBD 单元状态'
[[ $active_state == inactive || $active_state == failed ]] || die "原生 NBD 单元仍为 $active_state；必须先完成原生 stop"
obs_disconnect_entered=yes
obs_emit exit disconnect monitor_disconnect_started "NATIVE_ACTIVE_STATE=$active_state" "DETACH_ENABLED=$detach_enabled" || :
obs_call 1.6s snapshot disconnect-start exit || :
start=$SECONDS
if [[ $(device_status) != disconnected ]]; then
    log '原生 NBD 已停止，但尚未确认设备归零；进入有限补做检查'
    obs_rescue=required
    if rescue_detach "$start"; then obs_rescue=$detach_result; else
        obs_rescue=$detach_result; obs_close_outcome=skipped_device_not_disconnected
        die "设备仍未安全解除；状态=$(device_status)，拒绝发送 zero=yes"
    fi
else
    obs_rescue=not_required
fi
if [[ $(device_status) != disconnected ]]; then
    obs_close_outcome=skipped_device_not_disconnected
    die '设备状态不是 disconnected，不能发送 zero=yes'
fi
log "原生 NBD 已停止且设备归零，开始 close: session=$session"
reply=
obs_close_outcome=pending; obs_close_started_at=${EPOCHREALTIME:-unknown}
obs_emit exit disconnect close_started "ZERO=yes" "SHARED_BUDGET_SEC=30" || :
while (( SECONDS - start < 30 )); do
    remaining=$((30 - (SECONDS - start)))
    budget=$request_timeout_sec
    ((budget <= remaining)) || budget=$remaining
    ((obs_close_attempts+=1))
    obs_request_started=${EPOCHREALTIME:-unknown}
    if reply=$(timeout --signal=TERM --kill-after=1s "${budget}s"         "$0" _wire "$control_host" "$control_port"         'op=close' "session=$session" 'zero=yes'); then
        obs_close_last=$reply
        obs_emit exit disconnect close_reply "ATTEMPT=$obs_close_attempts" "REQUEST_EPOCH=$obs_request_started" "REPLY=$reply" "ZERO=yes" || :
        case $reply in
            result=complete|result=abnormal)
                obs_close_outcome=${reply#result=}
                save_state closed
                close_result=${reply#result=}
                [[ $close_result != abnormal || ( $sticky_fault != none && $sticky_fault != unknown ) ]] || sticky_fault=server_close_abnormal
                save_health
                log "结束结果=$reply；本地标记 closed（不表示文件系统一致性）"
                # 控制层已确认关闭，退出码 0 表示本地清理动作完成；异常事实留在状态、journal 和服务端。
                exit 0
                ;;
            result=wait) ((obs_close_waits+=1)) ;;
            *) obs_close_outcome=protocol_error; die "收尾回复不符合预期：$reply"
        esac
    else
        obs_wire_rc=$?
        ((obs_close_no_reply+=1))
        obs_emit exit disconnect close_unacknowledged "ATTEMPT=$obs_close_attempts" "REQUEST_EPOCH=$obs_request_started" "WIRE_RC=$obs_wire_rc" "ZERO=yes" || :
    fi
    (( SECONDS - start + 1 < 30 )) || break
    sleep 1
done
if ((obs_close_attempts == 0)); then obs_close_outcome=budget_exhausted_before_attempt
elif ((obs_close_waits == obs_close_attempts)); then obs_close_outcome=timeout_waiting_server
else obs_close_outcome=unacknowledged_or_wait_timeout; fi
die '30 秒内未能取得本轮服务端结束确认；本地 session 原样保留'
