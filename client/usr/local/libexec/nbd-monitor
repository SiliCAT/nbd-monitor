#!/bin/bash
# nbd-monitor v0.0.1 — development skeleton; no runtime business implemented.
set -euo pipefail

case "${1:-}" in
    --version)
        printf '%s\n' 'nbd-monitor 0.0.1 (development skeleton)'
        ;;
    --help|-h)
        printf '%s\n' 'nbd-monitor --version | --help' \
            'Reserved entry points (not implemented): run DEVICE | disconnect DEVICE | report DEVICE' \
            'Development skeleton. Do not deploy.'
        ;;
    *)
        printf '%s\n' 'nbd-monitor: v0.0.1 development skeleton; operation not implemented. Do not deploy.' >&2
        exit 1
        ;;
esac
